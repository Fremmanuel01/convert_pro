# Cloudflare R2 object storage (S3-compatible, used via the :amazon service).
# Storage falls back to local disk when AWS_ACCESS_KEY_ID is unset.
# Create an "Object Read & Write" API token in the R2 dashboard.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=officedoctools-files
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
