            }
            const zipped = zipSync(zipData)
            this.downloadBlob(new Blob([zipped], { type: 'application/zip' }), `split_${Date.now()}.zip`)
            this.reportActivity()
            this.formTarget.reset()
            this.resetUI()
        } catch (error) {
            console.error(error)
            alert("Failed to split PDF.")
        } finally {
            this.setProcessing(false)
        }
    }

