<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm your OfficedocTools account</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; padding: 0 16px; }
    .card { background: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1f3dff 0%, #0ea5e9 60%, #10b981 100%); padding: 40px 40px 32px; text-align: center; }
    .logo-wrap { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 24px; }
    .logo-img { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.15); padding: 4px; }
    .logo-name { color: #ffffff; font-size: 20px; font-weight: 800; letter-spacing: -0.5px; }
    .header-icon { width: 64px; height: 64px; background: rgba(255,255,255,0.15); border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .header h1 { color: #ffffff; font-size: 24px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 8px; }
    .header p { color: rgba(255,255,255,0.8); font-size: 15px; }
    .body { padding: 40px; }
    .greeting { font-size: 16px; color: #1e293b; font-weight: 600; margin-bottom: 12px; }
    .text { font-size: 15px; color: #64748b; line-height: 1.7; margin-bottom: 24px; }
    .btn-wrap { text-align: center; margin: 32px 0; }
    .btn { display: inline-block; background: linear-gradient(135deg, #1f3dff, #0ea5e9); color: #ffffff !important; text-decoration: none; font-size: 16px; font-weight: 700; padding: 16px 40px; border-radius: 12px; letter-spacing: 0.2px; box-shadow: 0 8px 24px rgba(31,61,255,0.3); }
    .divider { border: none; border-top: 1px solid #e2e8f0; margin: 28px 0; }
    .fallback { font-size: 13px; color: #94a3b8; line-height: 1.6; }
    .fallback a { color: #1f3dff; word-break: break-all; }
    .features { background: #f8fafc; border-radius: 12px; padding: 20px; margin: 24px 0; display: table; width: 100%; }
    .feature { display: table-row; }
    .feature-icon { display: table-cell; width: 36px; padding: 8px 12px 8px 0; vertical-align: middle; }
    .feature-icon span { display: inline-block; width: 28px; height: 28px; border-radius: 8px; text-align: center; line-height: 28px; font-size: 14px; }
    .feature-text { display: table-cell; font-size: 14px; color: #475569; vertical-align: middle; padding: 8px 0; font-weight: 500; }
    .footer { background: #f8fafc; padding: 24px 40px; text-align: center; border-top: 1px solid #e2e8f0; }
    .footer p { font-size: 13px; color: #94a3b8; line-height: 1.6; }
    .footer a { color: #1f3dff; text-decoration: none; }
    .expire-note { display: inline-block; background: #fef3c7; border: 1px solid #fde68a; color: #92400e; font-size: 13px; font-weight: 600; padding: 8px 16px; border-radius: 8px; margin-bottom: 24px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">

      <!-- Header -->
      <div class="header">
        <div class="logo-wrap">
          <img src="https://officedoctools.com/logo.png" alt="OfficedocTools" class="logo-img">
          <span class="logo-name">OfficedocTools</span>
        </div>
        <div style="font-size:36px; margin-bottom:12px;">✉️</div>
        <h1>Confirm your email</h1>
        <p>One click away from your document workspace</p>
      </div>

      <!-- Body -->
      <div class="body">
        <p class="greeting">Hi <%= @email %> 👋</p>
        <p class="text">
          Thanks for signing up to <strong>OfficedocTools</strong> — your all-in-one document and image conversion platform.
          Please confirm your email address to activate your account and get started.
        </p>

        <div class="btn-wrap">
          <span class="expire-note">⏱ Link expires in 24 hours</span><br>
          <%= link_to "Confirm my account →", confirmation_url(@resource, confirmation_token: @token), class: "btn" %>
        </div>

        <!-- What you get -->
        <div class="features">
          <div class="feature">
            <div class="feature-icon"><span style="background:rgba(31,61,255,0.1); color:#1f3dff;">⚡</span></div>
            <div class="feature-text"><%= ToolRegistry.tools.size %> professional conversion tools — PDF, Word, Excel, Images</div>
          </div>
          <div class="feature">
            <div class="feature-icon"><span style="background:rgba(16,185,129,0.1); color:#10b981;">🔒</span></div>
            <div class="feature-text">Files processed securely and auto-deleted after download</div>
          </div>
          <div class="feature">
            <div class="feature-icon"><span style="background:rgba(245,158,11,0.1); color:#f59e0b;">🌐</span></div>
            <div class="feature-text">Works in your browser — no software to install</div>
          </div>
        </div>

        <hr class="divider">

        <p class="fallback">
          Button not working? Copy and paste this link into your browser:<br>
          <a href="<%= confirmation_url(@resource, confirmation_token: @token) %>">
            <%= confirmation_url(@resource, confirmation_token: @token) %>
          </a>
        </p>
        <p class="fallback" style="margin-top:12px;">
          If you didn't create an account, you can safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          Sent by <a href="https://officedoctools.com">OfficedocTools</a> ·
          Free document conversion tools<br>
          Questions? Reply to this email or visit <a href="https://officedoctools.com">officedoctools.com</a>
        </p>
      </div>

    </div>
  </div>
</body>
</html>
