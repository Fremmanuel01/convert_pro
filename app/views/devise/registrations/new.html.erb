<% content_for :title, "Create your account — OfficeDocTools" %>

<%= render "devise/shared/auth_shell", title: "Create your free account", subtitle: "#{ConversionLimiter::FREE_LIMIT} free conversions to get started." do %>
  <%= render "devise/shared/google" %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "odt-input", placeholder: "you@example.com" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1.5">
        <%= f.label :password, class: "text-xs font-semibold text-slate-600 dark:text-slate-400" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-slate-400"><%= @minimum_password_length %>+ characters</span>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "new-password", required: true,
            class: "odt-input", placeholder: "Create a strong password" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "odt-input", placeholder: "Repeat your password" %>
    </div>

    <%= f.submit "Create account", class: "odt-btn odt-btn--primary odt-btn--block" %>
  <% end %>

  <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-5">
    Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-primary hover:underline" %>
  </p>
<% end %>
