<%# Centered auth card — the form is the primary object. locals: title, subtitle, block content %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-sm">
    <div class="flex items-center justify-center gap-2 mb-6">
      <img src="/logo.png" alt="" class="size-8 rounded-lg object-cover">
      <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">OfficeDocTools</span>
    </div>

    <div class="odt-card p-6 sm:p-8">
      <h1 class="text-xl font-bold text-slate-900 dark:text-white"><%= title %></h1>
      <% if local_assigns[:subtitle].present? %>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1"><%= subtitle %></p>
      <% end %>
      <div class="mt-6">
        <%= yield %>
      </div>
    </div>

    <p class="text-center text-xs text-slate-400 mt-5">
      Files are validated, processed over an encrypted connection, and deleted after processing.
    </p>
  </div>
</div>
