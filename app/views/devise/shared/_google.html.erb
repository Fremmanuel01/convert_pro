<%# Google/Firebase sign-in. Keeps the ids firebase_auth.js expects. %>
<div id="firebase-auth-error" class="hidden mb-3 rounded-lg border border-rose-200 dark:border-rose-500/20 bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-sm p-3">
  <span id="firebase-auth-error-msg"></span>
</div>

<button type="button" id="google-signin-btn"
        class="odt-btn odt-btn--secondary odt-btn--block">
  <svg class="size-[18px]" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
  Continue with Google
</button>

<div class="flex items-center gap-3 my-4">
  <div class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></div>
  <span class="text-xs text-slate-400">or</span>
  <div class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></div>
</div>
