<% content_for :title, "Sign in — OfficeDocTools" %>

<%= render "devise/shared/auth_shell", title: "Sign in", subtitle: "Welcome back to your workspace." do %>
  <%= render "devise/shared/google" %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "odt-input", placeholder: "you@example.com" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1.5">
        <%= f.label :password, class: "text-xs font-semibold text-slate-600 dark:text-slate-400" %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot?", new_password_path(resource_name), class: "text-xs font-semibold text-primary hover:underline" %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", required: true,
            class: "odt-input", placeholder: "••••••••" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
        <%= f.check_box :remember_me, class: "rounded border-slate-300 text-primary focus:ring-primary" %>
        Keep me signed in
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "odt-btn odt-btn--primary odt-btn--block" %>
  <% end %>

  <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-5">
    New here? <%= link_to "Create a free account", new_registration_path(resource_name), class: "font-semibold text-primary hover:underline" %>
  </p>
<% end %>
