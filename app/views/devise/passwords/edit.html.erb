<% content_for :title, "Choose a new password — OfficeDocTools" %>

<%= render "devise/shared/auth_shell", title: "Choose a new password" do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <div class="flex items-center justify-between mb-1.5">
        <%= f.label :password, "New password", class: "text-xs font-semibold text-slate-600 dark:text-slate-400" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-slate-400"><%= @minimum_password_length %>+ characters</span>
        <% end %>
      </div>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
            class: "odt-input", placeholder: "New password" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "odt-input", placeholder: "Repeat new password" %>
    </div>

    <%= f.submit "Update password", class: "odt-btn odt-btn--primary odt-btn--block" %>
  <% end %>
<% end %>
