<% content_for :title, "Reset password — OfficeDocTools" %>

<%= render "devise/shared/auth_shell", title: "Reset your password", subtitle: "We'll email you a reset link." do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div>
      <%= f.label :email, class: "block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "odt-input", placeholder: "you@example.com" %>
    </div>
    <%= f.submit "Send reset link", class: "odt-btn odt-btn--primary odt-btn--block" %>
  <% end %>

  <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-5">
    <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-semibold text-primary hover:underline" %>
  </p>
<% end %>
