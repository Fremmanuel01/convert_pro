<header class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-4">
  <div class="flex flex-col gap-1">
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">Pro Analytics Dashboard</h1>
    <p class="text-slate-500 dark:text-slate-400 font-medium">Welcome back, <%= current_user.email.split('@').first.capitalize %>! Here is your conversion engine performance.</p>
  </div>
  <div class="flex flex-wrap gap-3 w-full sm:w-auto mt-2 sm:mt-0">
    <button class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-white font-bold text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
      <span class="material-symbols-outlined text-lg">download</span>
      Export Report
    </button>
  </div>
</header>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="glass-card p-6 rounded-2xl hover-glow group transition-all">
    <div class="flex justify-between items-start mb-4">
      <div class="p-3 bg-primary/10 rounded-xl text-primary group-hover:scale-110 transition-transform">
        <span class="material-symbols-outlined">swap_calls</span>
      </div>
      <span class="text-emerald-500 text-sm font-bold flex items-center bg-emerald-500/10 px-2 py-0.5 rounded-full">
        <span class="material-symbols-outlined text-sm mr-1">trending_up</span> <%= @growth_rate %>%
      </span>
    </div>
    <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest">Total Conversions</p>
    <p class="text-3xl font-black text-slate-900 dark:text-white mt-1"><%= @total_conversions %></p>
  </div>

  <div class="glass-card p-6 rounded-2xl hover-glow group transition-all">
    <div class="flex justify-between items-start mb-4">
      <div class="p-3 bg-indigo-500/10 rounded-xl text-indigo-500 group-hover:scale-110 transition-transform">
        <span class="material-symbols-outlined">cloud_done</span>
      </div>
      <span class="text-emerald-500 text-sm font-bold flex items-center bg-emerald-500/10 px-2 py-0.5 rounded-full">
        <span class="material-symbols-outlined text-sm mr-1">trending_up</span> Stable
      </span>
    </div>
    <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest">Storage Used</p>
    <p class="text-3xl font-black text-slate-900 dark:text-white mt-1">1.2 GB</p>
  </div>

  <div class="glass-card p-6 rounded-2xl hover-glow group transition-all">
    <div class="flex justify-between items-start mb-4">
      <div class="p-3 bg-purple-500/10 rounded-xl text-purple-500 group-hover:scale-110 transition-transform">
        <span class="material-symbols-outlined">bolt</span>
      </div>
      <span class="text-emerald-500 text-sm font-bold flex items-center bg-emerald-500/10 px-2 py-0.5 rounded-full">
        <span class="material-symbols-outlined text-sm mr-1">trending_up</span> 99.9%
      </span>
    </div>
    <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest">Server Uptime</p>
    <p class="text-3xl font-black text-slate-900 dark:text-white mt-1">Stellar</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Usage Analytics Section -->
  <div class="lg:col-span-2 glass-card rounded-2xl p-8 hover-glow transition-all">
    <div class="flex justify-between items-start sm:items-center flex-col sm:flex-row mb-8 gap-4">
      <div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Usage Analytics</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Real-time infrastructure utilization</p>
      </div>
      <div class="flex gap-2 bg-slate-100 dark:bg-slate-800 p-1 rounded-lg">
        <button class="px-4 py-1.5 rounded-md text-xs font-bold bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm">Monthly</button>
        <button class="px-4 py-1.5 rounded-md text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Yearly</button>
      </div>
    </div>
    
    <div class="space-y-8">
      <div class="flex flex-col gap-3">
        <div class="flex justify-between items-end">
          <p class="text-slate-900 dark:text-white font-bold">Conversions Used</p>
          <div class="text-right">
            <span class="text-slate-900 dark:text-white font-black text-xl tracking-tight"><%= @total_conversions %></span>
            <span class="text-slate-500 text-sm"> / <%= current_user.pro? && current_user.active? ? 'Unlimited' : current_user.conversion_limit_per_day %></span>
          </div>
        </div>
        
        <div class="h-4 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden p-0.5">
          <% usage_percentage = current_user.pro? && current_user.active? ? 100 : (@total_conversions.to_f / current_user.conversion_limit_per_day * 100).clamp(0, 100) %>
          <div class="h-full bg-gradient-to-r from-primary to-indigo-400 rounded-full transition-all duration-1000" style="width: <%= usage_percentage %>%;"></div>
        </div>
        
        <% if current_user.pro? && current_user.active? %>
          <div class="flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-widest mt-1">
            <span class="material-symbols-outlined text-sm">verified</span>
            Pro plan: unlimited usage enabled
          </div>
        <% else %>
          <div class="flex items-center gap-2 text-amber-500 font-bold text-xs uppercase tracking-widest mt-1">
            <span class="material-symbols-outlined text-sm">info</span>
            Free plan: <%= [current_user.conversion_limit_per_day - @total_conversions, 0].max %> conversions remaining
          </div>
        <% end %>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
          <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">API Calls</p>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-black text-slate-900 dark:text-white">124</span>
            <span class="text-emerald-500 text-[10px] font-bold bg-emerald-500/10 px-1.5 py-0.5 rounded">+14%</span>
          </div>
        </div>
        <div class="p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
          <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Server Latency</p>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-black text-slate-900 dark:text-white">24ms</span>
            <span class="text-emerald-500 text-[10px] font-bold bg-emerald-500/10 px-1.5 py-0.5 rounded">STABLE</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity Section -->
  <div class="lg:col-span-1 glass-card rounded-2xl p-6 hover-glow transition-all flex flex-col">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Recent Activity</h3>
    <div class="flex flex-col gap-2 flex-grow">
      <% if @recent_activity.any? %>
        <% @recent_activity.each do |conversion| %>
          <div class="flex gap-4 items-center p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-white/5 transition-colors group">
            <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform flex-shrink-0">
              <span class="material-symbols-outlined text-lg">transform</span>
            </div>
            <div class="flex flex-col overflow-hidden">
              <p class="text-sm font-bold text-slate-900 dark:text-white truncate">Converted File <%= conversion.id %></p>
              <p class="text-xs text-slate-500"><%= time_ago_in_words(conversion.created_at) %> ago</p>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex items-center justify-center h-full flex-col text-slate-400 py-10">
          <span class="material-symbols-outlined text-4xl mb-2 opacity-50">analytics</span>
          <p class="text-sm">No recent activity found.</p>
        </div>
      <% end %>

      <!-- Placeholder rows to match design if we don't have enough -->
      <% (5 - @recent_activity.count).times do %>
        <div class="flex gap-4 items-center p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-white/5 transition-colors group opacity-50 grayscale pointer-events-none">
          <div class="size-10 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-slate-400 flex-shrink-0">
            <span class="material-symbols-outlined text-lg">hourglass_empty</span>
          </div>
          <div class="flex flex-col">
            <p class="text-sm font-bold text-slate-500">Awaiting Conversion</p>
            <p class="text-xs text-slate-400">...</p>
          </div>
        </div>
      <% end %>
    </div>
    
    <button class="w-full mt-6 py-2.5 text-slate-600 dark:text-slate-400 text-sm font-bold border border-slate-300 dark:border-slate-700 rounded-xl hover:bg-slate-100 dark:hover:bg-white/5 hover:text-slate-900 dark:hover:text-white transition-all">
      View All Activity
    </button>
  </div>
</div>
