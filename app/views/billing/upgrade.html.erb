<div class="w-full flex items-center justify-center min-h-[70vh] px-6 py-10">
  <div class="w-full max-w-lg">
    <% cycle = params[:plan] == 'yearly' ? 'yearly' : 'monthly'
       price = "#{BillingPlans.display_price(cycle)}/#{BillingPlans.fetch(cycle)[:cycle]}" %>

    <% if params[:reason].present? %>
      <div class="mb-6">
        <%= render "shared/upgrade_prompt", reason: params[:reason], cycle: cycle, compact: true %>
      </div>
    <% end %>

    <div class="odt-card p-8 sm:p-10">
      <div class="size-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5">
        <span class="material-symbols-outlined text-2xl" style="font-variation-settings:'FILL' 1;">workspace_premium</span>
      </div>

      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">
        OfficeDocTools Pro — <%= cycle.capitalize %>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 mb-6">
        You'll be billed <span class="font-semibold text-slate-900 dark:text-white"><%= price %></span> through Paystack.
      </p>

      <ul class="space-y-2.5 mb-8">
        <% BillingPlans.pro_features.each do |f| %>
          <li class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-[20px] text-primary"><%= f[:icon] %></span>
            <%= f[:text] %>
          </li>
        <% end %>
      </ul>

      <%= button_to create_subscription_billing_path(plan: cycle),
            class: "odt-btn odt-btn--primary odt-btn--lg odt-btn--block", data: { turbo: false } do %>
        <span class="material-symbols-outlined text-[20px]">lock</span>
        Continue to secure checkout
      <% end %>

      <div class="mt-4 flex items-center justify-between">
        <%= link_to "Back to plans", pricing_path, class: "text-sm font-medium text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
          <span class="material-symbols-outlined text-[15px]">verified_user</span>
          Powered by Paystack
        </span>
      </div>
    </div>
  </div>
</div>
