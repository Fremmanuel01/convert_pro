<div class="w-full flex justify-center items-center min-h-[75vh] px-6">
  <% if current_user.pro? %>
    <% track_conversion(ga: "purchase", fb: "Purchase",
         params: { value: BillingPlans.amount_minor("monthly") / 100.0, currency: BillingPlans::CURRENCY }) %>
    <div class="w-full max-w-md odt-card p-8 sm:p-10 text-center">
      <div class="mx-auto mb-6 size-14 rounded-full bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
        <span class="material-symbols-outlined text-[32px]" style="font-variation-settings:'FILL' 1;">check_circle</span>
      </div>

      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white mb-2">Payment successful</h1>
      <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
        Thanks for subscribing. Your Pro plan is now active.
      </p>

      <div class="flex items-center justify-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-8">
        <span class="material-symbols-outlined text-[18px] animate-spin" style="font-variation-settings:'FILL' 1;">progress_activity</span>
        Confirming subscription status…
      </div>

      <%= link_to "Go to your dashboard", dashboard_path, class: "odt-btn odt-btn--primary odt-btn--lg odt-btn--block" %>
    </div>
  <% else %>
    <div class="w-full max-w-md odt-card p-8 sm:p-10 text-center">
      <div class="mx-auto mb-6 size-14 rounded-full bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center">
        <span class="material-symbols-outlined text-[32px]" style="font-variation-settings:'FILL' 1;">error</span>
      </div>

      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white mb-2">Payment incomplete</h1>
      <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-8">
        The transaction was abandoned or declined. No charges were made to your account.
      </p>

      <div class="space-y-3">
        <%= link_to "Try again", upgrade_billing_path, class: "odt-btn odt-btn--primary odt-btn--lg odt-btn--block" %>
        <%= link_to "Return to dashboard", dashboard_path, class: "odt-btn odt-btn--secondary odt-btn--lg odt-btn--block" %>
      </div>
    </div>
  <% end %>
</div>
