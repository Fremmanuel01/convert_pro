<div class="max-w-3xl mx-auto w-full mt-6">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb" class="mb-6 flex text-sm text-slate-500 font-medium">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "Dashboard", dashboard_path, class: "hover:text-primary transition-colors text-decoration-none" %></li>
      <li class="flex items-center space-x-2">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-slate-900 dark:text-white" aria-current="page">Billing & Plan</span>
      </li>
    </ol>
  </nav>

  <!-- Main Card -->
  <div class="glass-card rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-xl shadow-primary/5">
    <div class="px-8 py-6 border-b border-slate-200/50 dark:border-slate-800/50 flex items-center gap-4 bg-white/30 dark:bg-slate-900/30">
      <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-3xl">credit_card</span>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-1">Billing Options</h2>
        <p class="text-sm text-slate-500 leading-relaxed">Manage your subscription and usage limits.</p>
      </div>
    </div>
    
    <div class="p-8 bg-white/10 dark:bg-transparent">
      
      <div class="border border-slate-200/50 dark:border-slate-800/50 rounded-2xl p-8 bg-slate-50/50 dark:bg-slate-800/20 text-center relative overflow-hidden">
        <!-- Glow backing for Pro -->
        <% if current_user.pro? && current_user.active? %>
          <div class="absolute inset-0 bg-primary/5 pointer-events-none"></div>
        <% end %>

        <h5 class="text-sm font-semibold text-slate-500 uppercase tracking-widest mb-4">Your Current Plan</h5>
        <h1 class="text-5xl font-black mb-4 <%= current_user.pro? && current_user.active? ? 'text-transparent bg-clip-text bg-gradient-to-r from-primary to-indigo-400' : 'text-slate-900 dark:text-white' %>">
          <%= current_user.plan.capitalize %>
        </h1>
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold mb-8 <%= current_user.active? ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : (current_user.free? ? 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700' : 'bg-red-500/10 text-red-500 border border-red-500/20') %>">
          <span class="material-symbols-outlined text-[14px]">
            <%= current_user.active? ? 'check_circle' : (current_user.free? ? 'info' : 'error') %>
          </span>
          <%= current_user.pro? ? "Subscription: #{current_user.subscription_status.capitalize}" : "Basic Access" %>
        </div>

        <div class="max-w-md mx-auto">
          <% if current_user.free? %>
            <p class="text-sm text-slate-500 mb-8 leading-relaxed">You are on the free tier. Upgrade to unlock unlimited conversions, advanced AI engines, and premium features.</p>
            <%= link_to "Upgrade to Pro", upgrade_billing_path, class: "w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl text-lg font-bold shadow-xl shadow-primary/30 transition-all text-decoration-none" %>
          <% elsif current_user.pro? && current_user.active? %>
            <p class="text-sm text-slate-500 mb-8 leading-relaxed text-center px-4">You have full access to ConvertPro features with unlimited conversions and priority processing queues.</p>
            <!-- In real app, put a Customer Portal link here via Paystack API to let them cancel/update card -->
            <button class="w-full inline-flex items-center justify-center gap-2 border-2 border-slate-300 dark:border-slate-700 text-slate-400 dark:text-slate-500 px-8 py-4 rounded-xl text-sm font-bold opacity-50 cursor-not-allowed">
              <span class="material-symbols-outlined">manufacturing</span>
              Manage on Paystack (Coming Soon)
            </button>
          <% else %>
            <p class="text-sm text-red-500 mb-8 leading-relaxed px-4 font-medium">Your Pro subscription is inactive or cancelled. Please renew to restore full access to premium tools.</p>
            <%= link_to "Renew Subscription", upgrade_billing_path, class: "w-full inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-white px-8 py-4 rounded-xl text-lg font-bold shadow-xl shadow-amber-500/30 transition-all text-decoration-none" %>
          <% end %>
        </div>

      </div>

    </div>
  </div>
</div>
