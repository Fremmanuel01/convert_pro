<%#
  Brand mark + wordmark. Flat, geometric, single-accent — no clipart.
  A document tile (primary) with an export/convert arrow.
  Locals: size (mark px, default 36), wordmark (default true), text_class (wordmark colour).
%>
<% size      = local_assigns.fetch(:size, 36)
   wordmark  = local_assigns.fetch(:wordmark, true)
   text_class = local_assigns.fetch(:text_class, "text-slate-900 dark:text-white") %>
<span class="inline-flex items-center gap-2.5 select-none">
  <svg width="<%= size %>" height="<%= size %>" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="11" class="text-primary" fill="currentColor"/>
    <path d="M14.5 10.5h7.2l5.8 5.8v12.2a1.5 1.5 0 0 1-1.5 1.5H14.5A1.5 1.5 0 0 1 13 28.5v-16.5a1.5 1.5 0 0 1 1.5-1.5z" fill="#fff"/>
    <path d="M21.7 10.5v4.3a1.5 1.5 0 0 0 1.5 1.5h4.3z" fill="#fff" fill-opacity="0.55"/>
    <path d="M20 19.3v6.4m0 0 2.6-2.6M20 25.7l-2.6-2.6" stroke="currentColor" class="text-primary" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <% if wordmark %>
    <span class="text-lg font-semibold tracking-tight <%= text_class %>">Officedoc<span class="text-primary">Tools</span></span>
  <% end %>
</span>
