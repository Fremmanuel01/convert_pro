<% if flash.any? %>
  <div class="fixed top-4 right-4 z-[9999] flex flex-col gap-2">
    <% flash.each do |key, message| %>
      <% next if message.blank? %>
      <% error = key.to_s == 'alert' || key.to_s == 'error' %>
      <div class="odt-card px-4 py-3 flex items-center gap-3 shadow-md <%= error ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600 dark:text-emerald-400' %>" role="alert">
        <span class="material-symbols-outlined text-[20px]"><%= error ? 'error' : 'check_circle' %></span>
        <span class="text-sm font-medium text-slate-900 dark:text-white"><%= message %></span>
      </div>
    <% end %>
  </div>
  <script>
    setTimeout(() => {
      document.querySelectorAll('[role="alert"]').forEach(el => {
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.5s ease';
        setTimeout(() => el.remove(), 500);
      });
    }, 5000);
  </script>
<% end %>
