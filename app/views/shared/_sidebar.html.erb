<!-- Mobile Sidebar Overlay -->
<div data-sidebar-target="overlay" data-action="click->sidebar#toggle" id="sidebar-overlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden md:hidden backdrop-blur-sm"></div>

<aside data-sidebar-target="sidebar" id="app-sidebar" class="w-72 flex flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6 justify-between shrink-0 overflow-y-auto fixed md:relative z-30 transition-transform -translate-x-full md:translate-x-0 h-full shadow-2xl md:shadow-none">
<div class="space-y-8">
<!-- Branding -->
<a href="<%= root_path %>" class="flex items-center gap-3 text-decoration-none">
<div class="size-10 bg-primary rounded-xl flex items-center justify-center text-white">
<span class="material-symbols-outlined fill-1">layers</span>
</div>
<h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">ConvertPro</h2>
</a>
<!-- User Profile -->
<div class="flex items-center gap-3 p-2 bg-slate-100 dark:bg-slate-800/50 rounded-xl">
<div class="size-10 rounded-full bg-slate-300 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-400 font-bold uppercase">
  <%= current_user.email[0] %>
</div>
<div class="flex flex-col">
<h1 class="text-sm font-semibold text-slate-900 dark:text-white truncate w-32"><%= current_user.email.split('@').first %></h1>
<% if current_user.pro? && current_user.active? %>
<span class="text-[10px] uppercase tracking-wider font-bold text-primary bg-primary/20 px-1.5 py-0.5 rounded w-fit">Pro Member</span>
<% else %>
<span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 bg-slate-200 dark:bg-slate-800 px-1.5 py-0.5 rounded w-fit">Free Plan</span>
<% end %>
</div>
</div>
<!-- Navigation -->
<nav class="space-y-2">
<%= link_to dashboard_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors #{current_page?(dashboard_path) ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'}" do %>
<span class="material-symbols-outlined text-xl">dashboard</span>
<span class="text-sm font-medium">Dashboard</span>
<% end %>
<%= link_to analytics_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors #{current_page?(analytics_path) ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'}" do %>
<span class="material-symbols-outlined text-xl">analytics</span>
<span class="text-sm font-medium">Analytics</span>
<% end %>
<%= link_to tools_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors #{current_page?(tools_path) ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'}" do %>
<span class="material-symbols-outlined text-xl">build</span>
<span class="text-sm font-medium">Tools</span>
<% end %>
<%= link_to conversions_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors #{current_page?(conversions_path) ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'}" do %>
<span class="material-symbols-outlined text-xl">sync</span>
<span class="text-sm font-medium">Conversions</span>
<% end %>
<%= link_to billing_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors #{current_page?(billing_path) ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'}" do %>
<span class="material-symbols-outlined text-xl">settings</span>
<span class="text-sm font-medium">Billing</span>
<% end %>
</nav>

<!-- Usage Progress -->
<div class="p-4 glass-card rounded-xl space-y-3">
<div class="flex justify-between items-center">
<span class="text-xs font-medium text-slate-500"><%= current_user.pro? && current_user.active? ? 'Pro Limit' : 'Free Limit' %></span>
<span class="text-xs font-bold text-slate-900 dark:text-white">
  <%= current_user.pro? && current_user.active? ? 'Unlimited' : "#{current_user.conversions_count} / #{current_user.conversion_limit_per_day}" %>
</span>
</div>
<div class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
<div class="h-full bg-primary" style="width: <%= current_user.pro? && current_user.active? ? '100' : [((current_user.conversions_count.to_f / current_user.conversion_limit_per_day) * 100), 100].min %>%;"></div>
</div>
<p class="text-[10px] text-slate-500 text-center"><%= current_user.pro? && current_user.active? ? 'Premium Unlocked' : 'Resets daily at midnight' %></p>
</div>
</div>
<div class="space-y-4">
<% unless current_user.pro? && current_user.active? %>
<%= link_to pricing_path, class: "w-full flex items-center justify-center gap-2 bg-primary py-3 rounded-xl text-white font-bold text-sm shadow-xl shadow-primary/30" do %>
<span class="material-symbols-outlined text-lg">bolt</span>
Upgrade Plan
<% end %>
<% end %>
<%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors bg-transparent border-0 text-left" do %>
<span class="material-symbols-outlined text-xl">logout</span>
<span class="text-sm font-medium">Log out</span>
<% end %>
</div>
</aside>


