<%# Mobile overlay %>
<div data-sidebar-target="overlay" data-action="click->sidebar#toggle" id="sidebar-overlay" class="fixed inset-0 bg-slate-900/40 z-20 hidden md:hidden"></div>

<aside data-sidebar-target="sidebar" id="app-sidebar"
       class="w-64 flex flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark px-4 py-6 justify-between shrink-0 overflow-y-auto fixed md:relative z-30 transition-transform -translate-x-full md:translate-x-0 h-full">
  <div class="space-y-7">
    <%# Branding %>
    <a href="<%= root_path %>" class="flex items-center px-2">
      <%= render "shared/logo", size: 34 %>
    </a>

    <%# User %>
    <div class="flex items-center gap-3 px-2">
      <div class="size-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-semibold uppercase text-sm">
        <%= current_user.email[0] %>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-sm font-medium text-slate-900 dark:text-white truncate"><%= current_user.email.split('@').first %></span>
        <% if current_user.pro? && current_user.active? %>
          <span class="text-[11px] font-medium text-primary">Pro plan</span>
        <% else %>
          <span class="text-[11px] font-medium text-slate-500">Free plan</span>
        <% end %>
      </div>
    </div>

    <%# Navigation %>
    <nav class="space-y-1">
      <% nav = [[dashboard_path, "dashboard", "Dashboard"],
                [analytics_path, "monitoring", "Analytics"],
                [tools_path, "grid_view", "Tools"],
                [conversions_path, "history", "Conversions"],
                [billing_path, "settings", "Billing"]] %>
      <% nav.each do |path, icon, label| %>
        <% active = current_page?(path) %>
        <%= link_to path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors #{active ? 'bg-primary text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'}" do %>
          <span class="material-symbols-outlined text-[20px]"><%= icon %></span>
          <%= label %>
        <% end %>
      <% end %>
    </nav>
  </div>

  <%# Footer: usage + account %>
  <div class="space-y-4">
    <% pro = current_user.pro? && current_user.active?
       credit_left = current_user.premium_credits_used.to_i < ConversionLimiter::FREE_PREMIUM_CREDITS %>

    <% unless pro %>
      <div class="odt-card p-4 space-y-2.5">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-primary">auto_awesome</span>
          <span class="text-xs font-semibold text-slate-900 dark:text-white">
            <%= credit_left ? "Free AI & OCR try available" : "Free AI & OCR try used" %>
          </span>
        </div>
        <p class="text-[11px] leading-snug text-slate-500">Basic tools are always free. Pro adds unlimited AI &amp; OCR and larger files.</p>
        <%= link_to pricing_path, class: "odt-btn odt-btn--primary odt-btn--block odt-btn--sm" do %>
          <span class="material-symbols-outlined text-[18px]">bolt</span>Upgrade to Pro
        <% end %>
      </div>
    <% end %>

    <%= button_to destroy_user_session_path, method: :delete,
          class: "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white transition-colors bg-transparent border-0 text-left" do %>
      <span class="material-symbols-outlined text-[20px]">logout</span>Log out
    <% end %>
  </div>
</aside>
