<header data-controller="mobile-menu" class="relative z-10 px-6 lg:px-12 py-4 border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-background-dark/90 backdrop-blur-md sticky top-0">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <a href="<%= root_path %>" class="flex items-center z-20">
      <%= render "shared/logo", size: 32 %>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      <a class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors" href="<%= solutions_path %>">What you can do</a>
      <a class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors" href="<%= tools_path %>">Tools</a>
      <a class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors" href="<%= pricing_path %>">Pricing</a>
      <a class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors" href="<%= enterprise_path %>">For business</a>
    </nav>

    <div class="hidden md:flex items-center gap-2">
      <a href="<%= new_user_session_path %>" class="odt-btn odt-btn--ghost">Log in</a>
      <a href="<%= new_user_registration_path %>" class="odt-btn odt-btn--primary">Get started</a>
    </div>

    <button data-action="click->mobile-menu#toggle" id="mobile-menu-button" class="md:hidden flex items-center justify-center p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors z-20">
      <span data-mobile-menu-target="icon" class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <%# Mobile overlay %>
  <div data-mobile-menu-target="menu" id="mobile-menu" class="fixed inset-0 bg-white dark:bg-background-dark z-10 hidden flex-col pt-24 px-6 pb-6 h-screen overflow-y-auto">
    <nav class="flex flex-col gap-2 mb-8">
      <a class="text-xl font-semibold text-slate-900 dark:text-white py-2" href="<%= solutions_path %>">What you can do</a>
      <a class="text-xl font-semibold text-slate-900 dark:text-white py-2" href="<%= tools_path %>">Tools</a>
      <a class="text-xl font-semibold text-slate-900 dark:text-white py-2" href="<%= pricing_path %>">Pricing</a>
      <a class="text-xl font-semibold text-slate-900 dark:text-white py-2" href="<%= enterprise_path %>">For business</a>
    </nav>
    <div class="flex flex-col gap-3 mt-auto">
      <a href="<%= new_user_session_path %>" class="odt-btn odt-btn--secondary odt-btn--lg odt-btn--block">Log in</a>
      <a href="<%= new_user_registration_path %>" class="odt-btn odt-btn--primary odt-btn--lg odt-btn--block">Get started</a>
    </div>
  </div>
</header>
