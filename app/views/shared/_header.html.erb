<header class="h-20 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-6 md:px-8 bg-white dark:bg-background-dark/50 backdrop-blur-md relative z-40">
  <div class="flex-1 max-w-xl flex items-center gap-4">
    <button data-action="click->sidebar#toggle" id="sidebar-toggle" class="md:hidden size-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-primary transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>
  <div class="flex items-center gap-4 relative">
    <button data-controller="theme" data-action="click->theme#toggle" id="theme-toggle" class="size-10 flex-shrink-0 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
      <span class="material-symbols-outlined dark:!hidden">dark_mode</span>
      <span class="material-symbols-outlined !hidden dark:!block text-amber-300">light_mode</span>
    </button>
    <div class="h-8 w-[1px] bg-slate-200 dark:bg-slate-800 mx-2"></div>
    
    <!-- Profile Dropdown Container -->
    <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
      <button data-action="click->dropdown#toggle" id="profile-toggle" class="size-10 rounded-full bg-gradient-to-br from-primary to-indigo-400 p-0.5 hover:scale-105 transition-transform focus:outline-none">
        <div class="w-full h-full rounded-full border-2 border-white dark:border-background-dark bg-slate-300 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-slate-700 dark:text-slate-300 pointer-events-none">
          <%= current_user.email[0].upcase %>
        </div>
      </button>

      <!-- Dropdown Menu -->
      <div data-dropdown-target="menu" id="profile-dropdown" class="absolute right-0 top-full mt-2 w-56 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl opacity-0 invisible translate-y-2 transition-all duration-200 z-50 overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800">
          <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Signed in as</p>
          <p class="text-sm font-bold text-slate-900 dark:text-white truncate"><%= current_user.email %></p>
        </div>
        <div class="p-2 space-y-1">
          <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">dashboard</span> Dashboard
          <% end %>
          <%= link_to billing_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">credit_card</span> Subscription
          <% end %>
        </div>
        <div class="p-2 border-t border-slate-200 dark:border-slate-800">
          <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">logout</span> Sign out
          <% end %>
        </div>
      </div>
    </div>
    
  </div>
</header>

