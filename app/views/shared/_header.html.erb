<header class="h-16 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-6 md:px-8 bg-white dark:bg-background-dark relative z-40">
  <div class="flex items-center gap-4">
    <button data-action="click->sidebar#toggle" id="sidebar-toggle" class="md:hidden size-9 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <div class="flex items-center gap-2">
    <button data-controller="theme" data-action="click->theme#toggle" id="theme-toggle" class="size-9 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">
      <span class="material-symbols-outlined text-[22px] dark:!hidden">dark_mode</span>
      <span class="material-symbols-outlined text-[22px] !hidden dark:!block">light_mode</span>
    </button>

    <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
      <button data-action="click->dropdown#toggle" id="profile-toggle" class="size-9 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold uppercase hover:bg-primary/15 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">
        <%= current_user.email[0].upcase %>
      </button>

      <div data-dropdown-target="menu" id="profile-dropdown" class="absolute right-0 top-full mt-2 w-60 odt-card shadow-lg opacity-0 invisible translate-y-1 transition-all duration-150 z-50 overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800">
          <p class="text-xs text-slate-500 mb-0.5">Signed in as</p>
          <p class="text-sm font-medium text-slate-900 dark:text-white truncate"><%= current_user.email %></p>
        </div>
        <div class="p-1.5">
          <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">dashboard</span>Dashboard
          <% end %>
          <%= link_to billing_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">credit_card</span>Subscription
          <% end %>
        </div>
        <div class="p-1.5 border-t border-slate-200 dark:border-slate-800">
          <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors bg-transparent border-0 text-left" do %>
            <span class="material-symbols-outlined text-[18px]">logout</span>Sign out
          <% end %>
        </div>
      </div>
    </div>
  </div>
</header>
