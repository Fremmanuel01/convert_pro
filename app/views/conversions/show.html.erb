<div class="max-w-4xl mx-auto w-full mt-6">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb" class="mb-6 flex text-sm text-slate-500 font-medium">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "Tools", tools_path, class: "hover:text-primary transition-colors text-decoration-none" %></li>
      <li class="flex items-center space-x-2">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <%= link_to "History", conversions_path, class: "hover:text-primary transition-colors text-decoration-none" %>
      </li>
      <li class="flex items-center space-x-2">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-slate-900 dark:text-white" aria-current="page">Job #<%= @conversion.id %></span>
      </li>
    </ol>
  </nav>

  <!-- Main Card -->
  <div class="glass-card rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-xl shadow-primary/5">
    
    <!-- Header -->
    <div class="px-6 py-6 sm:px-8 border-b border-slate-200/50 dark:border-slate-800/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/30 dark:bg-slate-900/30">
      <div class="flex items-center gap-4">
        <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-3xl">
            <%= @tool_meta ? @tool_meta[:icon] : 'description' %>
          </span>
        </div>
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-1">
            <%= @tool_meta ? @tool_meta[:name] : 'Conversion Details' %>
          </h2>
          <p class="text-sm text-slate-500 leading-relaxed">Processing Job #<%= @conversion.id %></p>
        </div>
      </div>
      
    </div>
    
    <!-- Body -->
    <div class="p-6 sm:p-8 bg-white/10 dark:bg-transparent">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        
        <!-- Input Files -->
        <div class="md:border-r border-slate-200 dark:border-slate-800 md:pr-8">
          <h3 class="text-xs font-bold tracking-wider text-slate-400 uppercase mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">folder</span>
            Input Files (<%= @conversion.input_files.count %>)
          </h3>
          <ul class="space-y-3">
            <% @conversion.input_files.each do |file| %>
              <li class="flex items-start gap-3 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white/50 dark:bg-slate-900/50 p-2.5 rounded-lg border border-slate-100 dark:border-slate-800">
                <span class="material-symbols-outlined text-rose-500 shrink-0 mt-0.5">picture_as_pdf</span>
                <span class="break-all mt-0.5" title="<%= file.filename %>"><%= truncate(file.filename.to_s, length: 60) %></span>
              </li>
            <% end %>
          </ul>
        </div>
        
        <!-- Execution Details -->
        <div class="md:pl-2">
          <h3 class="text-xs font-bold tracking-wider text-slate-400 uppercase mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">info</span>
            Execution Details
          </h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/30 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-800/50">
              <span class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">schedule</span> Started</span>
              <span class="text-sm font-bold text-slate-900 dark:text-white"><%= time_ago_in_words(@conversion.created_at) %> ago</span>
            </div>
            <div class="flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/30 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-800/50">
              <span class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">timer</span> Processing Time</span>
              <span class="text-sm font-bold text-slate-900 dark:text-white"><%= @conversion.processing_time ? "#{@conversion.processing_time.round(2)}s" : 'N/A' %></span>
            </div>
            <% if @conversion.output_file.attached? %>
            <div class="flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/30 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-800/50">
              <span class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">hard_drive</span> Output Size</span>
              <span class="text-sm font-bold text-slate-900 dark:text-white"><%= number_to_human_size(@conversion.output_file.byte_size) %></span>
            </div>
            <% end %>
          </div>
        </div>
        
      </div>

      <!-- Live status / result — updates in place via Turbo Frame + poll -->
      <%= render "conversions/status",
            conversion: @conversion, tool_meta: @tool_meta,
            recommendations: @recommendations, auto_download: @auto_download %>

    </div>
  </div>
  
  <div class="mt-6 mb-12 text-center">
    <%= link_to conversions_path, class: "inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-primary transition-colors bg-white/50 dark:bg-slate-800/50 px-6 py-2.5 rounded-full border border-slate-200 dark:border-slate-700" do %>
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Back to History
    <% end %>
  </div>
</div>
