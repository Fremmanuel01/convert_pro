<% content_for :title, "All #{tool_count} Document Tools — Free Online | OfficedocTools" %>
<% content_for :meta_description, "Browse all #{tool_count} free online document tools — convert, compress, merge, split, protect, OCR and more for PDF, Word, Excel, PowerPoint and images. No signup needed." %>
<% content_for :jsonld do %>
  <%= json_ld({
    "@context" => "https://schema.org", "@type" => "CollectionPage",
    "name" => "All document tools", "url" => canonical_url(tools_path),
    "description" => "Every free document tool offered by OfficedocTools."
  }) %>
<% end %>

<div class="max-w-7xl mx-auto w-full mt-8 px-4 sm:px-6 mb-20" id="tools-container"
     data-controller="tool-filter">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">All tools</h1>
    <p class="text-slate-500 dark:text-slate-400 text-base max-w-2xl">Everything you need to get a document ready for work — organised by what you want to do.</p>
  </div>

  <!-- Search + group filters -->
  <div class="flex flex-col lg:flex-row lg:items-center gap-4 mb-8">
    <div class="relative flex-1 max-w-md">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]" aria-hidden="true">search</span>
      <input type="search" data-tool-filter-target="search" data-action="input->tool-filter#search"
             placeholder="Search tools (e.g. compress, HEIC, Word)…"
             aria-label="Search tools"
             class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 pl-11 pr-4 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition">
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto hide-scrollbar" role="tablist" aria-label="Filter tools by category">
      <button type="button" role="tab" aria-selected="true" data-tool-filter-target="tab" data-action="tool-filter#filter" data-filter="all"
              class="tool-tab is-active whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition">All</button>
      <% ToolRegistry.group_names.each do |group| %>
        <button type="button" role="tab" aria-selected="false" data-tool-filter-target="tab" data-action="tool-filter#filter" data-filter="<%= group %>"
                class="tool-tab whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium transition"><%= group %></button>
      <% end %>
    </div>
  </div>

  <!-- Grouped sections -->
  <div data-tool-filter-target="empty" hidden class="text-center py-16 text-slate-500">
    <span class="material-symbols-outlined text-4xl text-slate-300 dark:text-slate-600 mb-2">search_off</span>
    <p class="font-medium">No tools match your search.</p>
  </div>

  <% ToolRegistry.groups.each do |group, tools| %>
    <section class="tool-group mb-10" data-tool-filter-target="group" data-group="<%= group %>">
      <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-4">
        <span class="material-symbols-outlined text-[18px] text-primary"><%= ToolRegistry::GROUP_ICONS[group] %></span>
        <%= group %>
        <span class="text-slate-300 dark:text-slate-600 font-medium normal-case">· <%= tools.size %></span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% tools.each do |tool| %>
          <%= link_to tool_path(tool[:id]),
                class: "tool-card group flex flex-col rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 hover:border-primary/40 hover:shadow-md transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
                data: { category: group, name: "#{tool[:name]} #{tool[:description]} #{ToolRegistry.search_terms(tool[:id]).join(' ')}".downcase } do %>
            <div class="size-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[24px]"><%= tool[:icon] %></span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1"><%= tool[:name] %></h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-grow"><%= tool[:description] %></p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary">
              Open
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
            </span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Upgrade CTA (restrained) -->
  <% unless current_user&.pro? && current_user&.active? %>
    <div class="mt-6 rounded-2xl bg-slate-900 dark:bg-slate-800 text-white p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left">
        <h2 class="text-xl font-bold mb-1">Need more than 5 conversions?</h2>
        <p class="text-slate-300 text-sm max-w-md">Pro gives you unlimited conversions, larger files, priority processing and 30-day history.</p>
      </div>
      <%= link_to "See Pro", pricing_path,
            class: "shrink-0 bg-white text-slate-900 hover:bg-slate-100 font-semibold py-3 px-6 rounded-xl transition-colors text-decoration-none" %>
    </div>
  <% end %>
</div>
