<div class="max-w-3xl mx-auto w-full mt-6">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb" class="mb-6 flex text-sm text-slate-500 font-medium">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "Tools", tools_path, class: "hover:text-primary transition-colors text-decoration-none" %></li>
      <li class="flex items-center space-x-2">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-slate-900 dark:text-white" aria-current="page"><%= @tool[:name] %></span>
      </li>
    </ol>
  </nav>

  <!-- Main Card -->
  <div class="glass-card rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-xl shadow-primary/5">
    <div class="px-8 py-6 border-b border-slate-200/50 dark:border-slate-800/50 flex items-center gap-4 bg-white/30 dark:bg-slate-900/30">
      <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-3xl"><%= @tool[:icon] || 'transform' %></span>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-1"><%= @tool[:name] %></h2>
        <p class="text-sm text-slate-500 leading-relaxed"><%= @tool[:description] %></p>
      </div>
    </div>
    
    <div class="p-8 bg-white/10 dark:bg-transparent">
      <% select_class = "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white" %>

      <%= form_with url: tools_path(tool_id: @tool[:id]), method: :post, local: true, multipart: true, class: "space-y-6 relative z-10",
          data: {
            controller: "client-tool",
            client_tool_tool_id_value: @tool[:id],
            client_tool_accepts_multiple_value: @tool[:accepts_multiple],
            client_tool_log_url_value: log_conversions_path,
            action: "submit->client-tool#process",
            client_tool_target: "form"
          } do |f| %>
        
        <% if @tool[:input_type] == :prompt %>
          <!-- AI Prompt Input -->
          <div class="p-8 border-2 border-dashed border-primary/40 rounded-3xl bg-primary/5 dark:bg-primary/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">auto_awesome</span>
              </div>
              <div>
                <h5 class="text-lg font-bold text-slate-900 dark:text-white">Describe what you want</h5>
                <p class="text-sm text-slate-500">Claude AI will generate your <%= @tool[:id].include?('pptx') ? 'presentation' : 'document' %> in seconds.</p>
              </div>
            </div>
            <%= f.text_area :prompt,
                rows: 4,
                required: true,
                placeholder: @tool[:id].include?('pptx') ?
                  "e.g. A 10-slide presentation on the future of renewable energy for a board meeting" :
                  "e.g. A comprehensive business proposal for a SaaS startup targeting the healthcare industry",
                class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400 resize-none" %>
            <p class="text-xs text-slate-400 mt-2">Be specific — the more detail you provide, the better the output.</p>
          </div>
        <% elsif @tool[:accepted_types].empty? %>
          <!-- URL Input for Webpage to PDF -->
          <div class="p-8 text-center border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-3xl bg-slate-50/50 dark:bg-slate-800/20 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors group">
            <div class="size-16 mx-auto bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-4xl">link</span>
            </div>
            <h5 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Enter Webpage URL</h5>
            <p class="text-sm text-slate-500 mb-6">We'll securely capture its formatting into a PDF document.</p>
            <div class="max-w-md mx-auto relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">language</span>
              <%= f.url_field :url, class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400 shadow-sm", placeholder: "https://example.com", required: true %>
            </div>
          </div>
        <% else %>
          <!-- Upload container: drop zone + preview zone -->
          <div id="upload-container">

            <!-- Drop / Browse zone -->
            <div class="relative p-8 text-center border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-3xl bg-slate-50/50 dark:bg-slate-800/20 hover:border-primary/50 transition-colors group cursor-pointer" id="upload-zone">
              <%= f.file_field :files, multiple: @tool[:accepts_multiple], accept: @tool[:accepted_types].join(','),
                  class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20",
                  required: true, id: "file_input",
                  data: { client_tool_target: "fileInput" } %>
              <div class="pointer-events-none relative z-10 flex flex-col items-center justify-center">
                <div class="size-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-4xl">cloud_upload</span>
                </div>
                <h5 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Select files to process</h5>
                <p class="text-sm font-medium mb-6 <%= current_user&.pro? && current_user&.active? ? 'text-primary' : 'text-slate-500' %>">
                  <% if current_user&.pro? && current_user&.active? %>
                    <span class="material-symbols-outlined text-[14px] align-middle mr-1">verified</span>Pro limit: Max 100MB
                  <% else %>
                    Free limit: Max 10MB
                  <% end %>
                </p>
                <div class="inline-flex items-center gap-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-6 py-2.5 rounded-xl text-sm font-bold group-hover:-translate-y-0.5 transition-transform">
                  Browse Files
                </div>
              </div>
            </div>

            <!-- Preview zone (shown once files are selected) -->
            <div id="file-preview-zone" class="hidden rounded-3xl border-2 border-primary/20 dark:border-primary/30 bg-slate-50 dark:bg-slate-900 overflow-hidden">

              <!-- Header bar -->
              <div class="px-5 py-3 bg-primary/5 dark:bg-primary/10 border-b border-primary/10 dark:border-primary/20 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[14px] text-primary">preview</span>
                  Document Preview
                </span>
                <button type="button" id="change-file-btn"
                        class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">swap_horiz</span>
                  Change file
                </button>
              </div>

              <!-- Thumbnail grid -->
              <div id="preview-thumbnails"
                   class="p-6 flex flex-wrap gap-5 justify-center items-end min-h-[200px]">
                <!-- thumbnail cards injected by JS -->
              </div>

              <!-- Footer bar: file info + active effects -->
              <div class="px-5 py-3 bg-slate-100/70 dark:bg-slate-800/40 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
                <span id="preview-file-info" class="text-xs font-medium text-slate-500 dark:text-slate-400"></span>
                <div id="preview-effects-bar" class="flex flex-wrap gap-1.5"></div>
              </div>

            </div>
          </div>
        <% end %>

        <%
          page_layout_tools  = %w[images_to_pdf docx_to_pdf xlsx_to_pdf pptx_to_pdf]
          has_page_layout    = page_layout_tools.include?(@tool[:id])
          has_password       = %w[protect_pdf unlock_pdf].include?(@tool[:id])
          has_quality        = @tool[:id] == 'compress_pdf'
          has_dpi            = @tool[:id] == 'pdf_to_images'
          has_ocr_lang       = @tool[:id] == 'ocr_pdf'
          has_rotation       = @tool[:id] == 'rotate_pdf'
          has_watermark      = @tool[:id] == 'watermark_pdf'
          has_translate      = @tool[:id] == 'ai_translate_pdf'
          has_pptx_opts      = @tool[:id] == 'ai_generate_pptx'
          has_docx_opts      = @tool[:id] == 'ai_generate_docx'
          has_split_range    = @tool[:id] == 'split_pdf'
          has_summarize_opts = @tool[:id] == 'summarize_pdf'
          has_image_quality  = %w[jpg_to_png png_to_jpg heic_to_jpg webp_to_jpg].include?(@tool[:id])
          has_merge_opts     = @tool[:id] == 'merge_pdf'
        %>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-700/50 overflow-hidden">
          <!-- Options Header (toggle) -->
          <button type="button" id="options-toggle" onclick="toggleOptions()" class="w-full flex items-center justify-between px-5 py-4 bg-slate-50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-left">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300">
              <span class="material-symbols-outlined text-[18px] text-primary">tune</span>
              Document Options
              <span class="text-xs font-normal text-slate-400 ml-1">— customise output settings</span>
            </div>
            <span id="options-chevron" class="material-symbols-outlined text-slate-400 transition-transform duration-200 rotate-180">expand_more</span>
          </button>

          <!-- Options Body (open by default) -->
          <div id="options-body" class="px-5 pb-5 pt-4 bg-white/50 dark:bg-slate-900/30 space-y-5">

            <!-- Page Layout (size + orientation) -->
            <% if has_page_layout %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">article</span> Page Layout
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Page Size</label>
                  <%= f.select :page_size,
                    [['A4 (International)', 'A4'], ['A3 (Large)', 'A3'], ['US Letter', 'Letter'], ['US Legal', 'Legal']],
                    { selected: 'A4' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Orientation</label>
                  <%= f.select :page_orientation,
                    [['Portrait ↕', 'portrait'], ['Landscape ↔', 'landscape']],
                    { selected: 'portrait' },
                    class: select_class %>
                </div>
              </div>
            </div>
            <% end %>

            <!-- Image Fit (images_to_pdf only) -->
            <% if @tool[:id] == 'images_to_pdf' %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">fit_screen</span> Image Placement
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Fit Mode</label>
                  <%= f.select :fit_mode,
                    [['Fit to Page (keep ratio)', 'fit'], ['Centre (original size)', 'center'], ['Stretch to Fill', 'stretch']],
                    { selected: 'fit' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Page Margin (px)</label>
                  <%= f.select :margin,
                    [['None (0)', '0'], ['Small (20)', '20'], ['Normal (40)', '40'], ['Wide (72)', '72']],
                    { selected: '0' },
                    class: select_class %>
                </div>
              </div>
            </div>
            <% end %>

            <!-- Compression Quality -->
            <% if has_quality %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">compress</span> Compression Level
              </p>
              <%= f.select :quality,
                [['Screen — Smallest file (72 dpi)', 'screen'], ['Ebook — Balanced (150 dpi)', 'ebook'], ['Printer — High quality (300 dpi)', 'printer'], ['Prepress — Best quality (300 dpi + colour)', 'prepress']],
                { selected: 'ebook' },
                class: select_class %>
              <p class="text-xs text-slate-400 mt-1.5">Higher quality = larger file size.</p>
            </div>
            <% end %>

            <!-- PDF to Images: DPI + format -->
            <% if has_dpi %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">image</span> Image Settings
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Resolution (DPI)</label>
                  <%= f.select :dpi,
                    [['72 dpi — Web / preview', '72'], ['150 dpi — Standard (default)', '150'], ['300 dpi — Print quality', '300']],
                    { selected: '150' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Output Format</label>
                  <%= f.select :image_format,
                    [['JPG (smaller size)', 'jpg'], ['PNG (transparent support)', 'png']],
                    { selected: 'jpg' },
                    class: select_class %>
                </div>
              </div>
            </div>
            <% end %>

            <!-- OCR Language -->
            <% if has_ocr_lang %>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">translate</span> OCR Language
              </label>
              <%= f.select :language,
                [['English', 'eng'], ['Spanish', 'spa'], ['French', 'fra'], ['German', 'deu'], ['Portuguese', 'por'], ['Italian', 'ita'], ['Chinese Simplified', 'chi_sim'], ['Japanese', 'jpn'], ['Arabic', 'ara']],
                { selected: 'eng' },
                class: select_class %>
            </div>
            <% end %>

            <!-- Rotation -->
            <% if has_rotation %>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">rotate_right</span> Rotation Angle
              </label>
              <%= f.select :rotation,
                [['90° Clockwise', '90'], ['180°', '180'], ['270° Clockwise (90° Counter-clockwise)', '270']],
                {},
                class: select_class %>
            </div>
            <% end %>

            <!-- Password -->
            <% if has_password %>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">key</span>
                <%= @tool[:id] == 'protect_pdf' ? 'Encryption Password' : 'Document Password' %>
              </label>
              <%= f.text_field :password,
                  required: true,
                  data: { client_tool_target: "passwordInput" },
                  placeholder: (@tool[:id] == 'protect_pdf' ? "Enter a strong password" : "Enter the document password"),
                  class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400" %>
            </div>
            <% end %>

            <!-- Watermark options -->
            <% if has_watermark %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">branding_watermark</span> Watermark Settings
              </p>
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Watermark Text</label>
                  <%= f.text_field :watermark,
                      value: 'CONFIDENTIAL',
                      placeholder: 'e.g. CONFIDENTIAL, DRAFT, INTERNAL',
                      class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400" %>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Position</label>
                    <%= f.select :watermark_position,
                      [['Diagonal (centre)', 'diagonal'], ['Centre', 'center'], ['Header (top)', 'header'], ['Footer (bottom)', 'footer']],
                      { selected: 'diagonal' },
                      class: select_class %>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Opacity</label>
                    <%= f.select :opacity,
                      [['Light (10%)', '10'], ['Standard (15%)', '15'], ['Medium (25%)', '25'], ['Bold (40%)', '40']],
                      { selected: '15' },
                      class: select_class %>
                  </div>
                </div>
              </div>
            </div>
            <% end %>

            <!-- Translation target language -->
            <% if has_translate %>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">translate</span> Translate To
              </label>
              <%= f.select :target_language,
                [['Spanish', 'es'], ['French', 'fr'], ['German', 'de'], ['Portuguese', 'pt'], ['Italian', 'it'], ['Dutch', 'nl'], ['Polish', 'pl'], ['Russian', 'ru'], ['Chinese (Simplified)', 'zh'], ['Japanese', 'ja'], ['Arabic', 'ar'], ['Hindi', 'hi'], ['Korean', 'ko'], ['Turkish', 'tr'], ['English', 'en']],
                { selected: 'es' },
                class: select_class %>
            </div>
            <% end %>

            <!-- AI Presentation options -->
            <% if has_pptx_opts %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">slideshow</span> Presentation Settings
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Number of Slides</label>
                  <%= f.select :slide_count,
                    [['5 slides', '5'], ['8 slides (default)', '8'], ['10 slides', '10'], ['15 slides', '15']],
                    { selected: '8' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Tone / Style</label>
                  <%= f.select :tone,
                    [['Professional', 'professional'], ['Executive / Board', 'executive'], ['Creative & Engaging', 'creative'], ['Educational', 'educational'], ['Sales Pitch', 'persuasive sales pitch']],
                    { selected: 'professional' },
                    class: select_class %>
                </div>
              </div>
              <div class="mt-3">
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Target Audience</label>
                <%= f.text_field :audience,
                    placeholder: "e.g. C-suite executives, university students, sales team...",
                    class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400" %>
              </div>
            </div>
            <% end %>

            <!-- AI Document options -->
            <% if has_docx_opts %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">edit_document</span> Document Settings
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Document Type</label>
                  <%= f.select :doc_type,
                    [['Business Report', 'report'], ['Proposal', 'proposal'], ['Cover Letter', 'cover letter'], ['Executive Summary', 'executive summary'], ['Policy Document', 'policy document'], ['Article / Blog Post', 'article'], ['Research Brief', 'research brief']],
                    { selected: 'report' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Tone</label>
                  <%= f.select :tone,
                    [['Professional', 'professional'], ['Formal', 'formal'], ['Friendly', 'friendly'], ['Persuasive', 'persuasive'], ['Academic', 'academic']],
                    { selected: 'professional' },
                    class: select_class %>
                </div>
              </div>
              <div class="mt-3">
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Approximate Length</label>
                <%= f.select :page_count,
                  [['1 page', '1'], ['2–3 pages (default)', '3'], ['5 pages', '5'], ['10 pages', '10']],
                  { selected: '3' },
                  class: select_class %>
              </div>
            </div>
            <% end %>

            <!-- Split PDF: page range -->
            <% if has_split_range %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">content_cut</span> Page Range
              </p>
              <p class="text-xs text-slate-400 mb-3">Leave blank to split all pages. Specify a range to extract only those pages.</p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">From Page</label>
                  <%= f.number_field :from_page, placeholder: '1', min: 1,
                      class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400" %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">To Page</label>
                  <%= f.number_field :to_page, placeholder: 'Last', min: 1,
                      class: "w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-4 text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white placeholder:text-slate-400" %>
                </div>
              </div>
            </div>
            <% end %>

            <!-- Summarize PDF: length + focus -->
            <% if has_summarize_opts %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">summarize</span> Summary Settings
              </p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Summary Length</label>
                  <%= f.select :page_count,
                    [['Brief (1 page)', '1'], ['Standard (2–3 pages)', '3'], ['Detailed (5 pages)', '5']],
                    { selected: '3' },
                    class: select_class %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Tone</label>
                  <%= f.select :tone,
                    [['Professional', 'professional'], ['Academic', 'academic'], ['Simple & Clear', 'simple'], ['Executive Briefing', 'executive']],
                    { selected: 'professional' },
                    class: select_class %>
                </div>
              </div>
            </div>
            <% end %>

            <!-- Image conversion quality -->
            <% if has_image_quality %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">high_quality</span> Output Quality
              </p>
              <%= f.select :quality,
                [['Maximum quality (largest file)', '100'], ['High quality (default)', '90'], ['Balanced (75)', '75'], ['Compressed (60)', '60']],
                { selected: '90' },
                class: select_class %>
              <p class="text-xs text-slate-400 mt-1.5">Higher quality produces larger file sizes.</p>
            </div>
            <% end %>

            <!-- Merge PDF output options -->
            <% if has_merge_opts %>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">merge</span> Merge Options
              </p>
              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Output Page Size</label>
                <%= f.select :page_size,
                  [['Keep original sizes', ''], ['Standardise to A4', 'A4'], ['Standardise to US Letter', 'Letter']],
                  { selected: '' },
                  class: select_class %>
                <p class="text-xs text-slate-400 mt-1.5">Choose a size to normalise all pages in the merged output.</p>
              </div>
            </div>
            <% end %>

            <!-- Generic notice for tools with no specific options -->
            <% unless has_page_layout || has_password || has_quality || has_dpi || has_ocr_lang || has_rotation || has_watermark || has_translate || has_pptx_opts || has_docx_opts || has_split_range || has_summarize_opts || has_image_quality || has_merge_opts %>
            <div class="flex items-center gap-3 py-2 text-slate-400">
              <span class="material-symbols-outlined text-[20px]">check_circle</span>
              <p class="text-sm">This tool runs with optimal defaults — no additional settings required.</p>
            </div>
            <% end %>

          </div>
        </div>

        <!-- Settings Preview Panel -->
        <div id="settings-preview" class="rounded-2xl border border-primary/20 bg-primary/5 dark:bg-primary/10 p-5 hidden">
          <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[14px] text-primary">preview</span>
            Output Preview
          </p>
          <div class="flex items-start gap-6">
            <!-- Page visual -->
            <div class="shrink-0 flex flex-col items-center gap-2">
              <div id="preview-page" class="relative bg-white dark:bg-slate-800 border-2 border-primary/30 shadow-md transition-all duration-300 flex items-center justify-center"
                   style="width:60px;height:84px;border-radius:4px;">
                <!-- Fold corner -->
                <div class="absolute top-0 right-0 w-0 h-0" style="border-style:solid;border-width:0 12px 12px 0;border-color:transparent #6366f1 transparent transparent;opacity:0.4;"></div>
                <span id="preview-page-icon" class="material-symbols-outlined text-primary/40 text-[22px]">description</span>
              </div>
              <span id="preview-size-label" class="text-[10px] font-bold text-primary uppercase tracking-wide">A4</span>
            </div>
            <!-- Settings summary list -->
            <div class="flex-1 space-y-2" id="preview-settings-list">
              <p class="text-xs text-slate-400 italic">Adjust settings above to see your output preview.</p>
            </div>
          </div>
        </div>

        <%= f.button type: "submit", class: "w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-primary/30 transition-all hover:-translate-y-0.5 cursor-pointer flex items-center justify-center gap-2 relative z-20 mt-4",
            data: {
              client_tool_target: "submitButton",
              disable_with: @tool[:input_type] == :prompt ? "Generating with AI..." : "Uploading..."
            } do %>
          <% if @tool[:input_type] == :prompt %>
            <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
            Generate with Claude AI
          <% else %>
            Process Document
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          <% end %>
        <% end %>
      <% end %>

    </div>
  </div>
</div>

<script>
  // ── Document Thumbnail Preview Engine ───────────────────────────
  (function() {

    // Load PDF.js from CDN
    const pdfJsScript = document.createElement('script');
    pdfJsScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    document.head.appendChild(pdfJsScript);

    const THUMB_W = 130; // px width of each thumbnail canvas

    // ── helpers ──────────────────────────────────────────
    function fmtSize(bytes) {
      if (bytes < 1024)       return bytes + ' B';
      if (bytes < 1048576)    return (bytes/1024).toFixed(1) + ' KB';
      return (bytes/1048576).toFixed(2) + ' MB';
    }
    function getVal(name) {
      const el = document.querySelector(`[name$="[${name}]"],[name="${name}"]`);
      return el ? el.value : null;
    }
    function getLabel(name) {
      const el = document.querySelector(`[name$="[${name}]"],[name="${name}"]`);
      if (!el) return null;
      const opt = el.querySelector && el.querySelector('option:checked');
      return opt ? opt.textContent.trim() : el.value;
    }

    // ── thumbnail rendering ───────────────────────────────
    async function renderPdf(file, container) {
      const url  = URL.createObjectURL(file);
      const wrap = document.createElement('div');
      wrap.className = 'thumb-card flex flex-col items-center gap-2';

      const canvasWrap = document.createElement('div');
      canvasWrap.className = 'relative';
      const canvas = document.createElement('canvas');
      canvas.className = 'rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 bg-white transition-all duration-300';
      canvas.style.maxWidth = THUMB_W + 'px';
      canvas.id = 'thumb-canvas-' + Math.random().toString(36).slice(2);
      canvasWrap.appendChild(canvas);

      // Watermark overlay (hidden by default)
      const wmOverlay = document.createElement('div');
      wmOverlay.className = 'thumb-wm-overlay absolute inset-0 flex items-center justify-center pointer-events-none rounded-lg hidden';
      canvasWrap.appendChild(wmOverlay);

      wrap.appendChild(canvasWrap);

      const label = document.createElement('p');
      label.className = 'text-xs text-center text-slate-500 dark:text-slate-400 max-w-[130px] truncate';
      label.textContent = file.name;
      wrap.appendChild(label);

      const badge = document.createElement('p');
      badge.className = 'thumb-page-badge text-[10px] font-bold text-primary/60 uppercase tracking-wide';
      wrap.appendChild(badge);

      container.appendChild(wrap);

      try {
        await pdfJsScript.onload; // wait if still loading
        if (typeof pdfjsLib === 'undefined') {
          await new Promise(res => { pdfJsScript.addEventListener('load', res, {once:true}); });
        }
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        const pdf  = await pdfjsLib.getDocument(url).promise;
        const page = await pdf.getPage(1);
        const vp   = page.getViewport({ scale: 1 });
        const scale = THUMB_W / vp.width;
        const viewport = page.getViewport({ scale });

        canvas.width  = viewport.width;
        canvas.height = viewport.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
        badge.textContent = pdf.numPages + (pdf.numPages === 1 ? ' page' : ' pages');
        URL.revokeObjectURL(url);
        applySettingsToThumbs(); // apply current settings once rendered
      } catch(e) {
        canvas.width = THUMB_W; canvas.height = Math.round(THUMB_W * 1.414);
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#f1f5f9';
        ctx.fillRect(0,0,canvas.width,canvas.height);
        ctx.fillStyle = '#94a3b8';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('PDF', canvas.width/2, canvas.height/2);
        URL.revokeObjectURL(url);
      }
    }

    function renderImage(file, container) {
      const url  = URL.createObjectURL(file);
      const wrap = document.createElement('div');
      wrap.className = 'thumb-card flex flex-col items-center gap-2';

      const imgWrap = document.createElement('div');
      imgWrap.className = 'relative';

      const img = document.createElement('img');
      img.className = 'thumb-canvas rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 object-contain transition-all duration-300';
      img.style.maxWidth = THUMB_W + 'px';
      img.style.maxHeight = Math.round(THUMB_W * 1.5) + 'px';
      img.src = url;
      img.onload = () => { URL.revokeObjectURL(url); applySettingsToThumbs(); };
      imgWrap.appendChild(img);

      const wmOverlay = document.createElement('div');
      wmOverlay.className = 'thumb-wm-overlay absolute inset-0 flex items-center justify-center pointer-events-none rounded-lg hidden';
      imgWrap.appendChild(wmOverlay);

      wrap.appendChild(imgWrap);

      const label = document.createElement('p');
      label.className = 'text-xs text-center text-slate-500 dark:text-slate-400 max-w-[130px] truncate';
      label.textContent = file.name;
      wrap.appendChild(label);

      container.appendChild(wrap);
    }

    // ── apply settings effects to all thumbs ─────────────
    function applySettingsToThumbs() {
      const canvases = document.querySelectorAll('#preview-thumbnails canvas, #preview-thumbnails img.thumb-canvas');
      if (!canvases.length) return;

      const rotation    = getVal('rotation')          || '0';
      const quality     = getVal('quality')           || '';
      const dpi         = getVal('dpi')               || '';
      const orient      = getVal('page_orientation')  || '';
      const wmText      = getVal('watermark')         || '';
      const wmPos       = getVal('watermark_position')|| 'diagonal';
      const wmOpacity   = parseInt(getVal('opacity')  || '15') / 100;
      const targetLang  = getLabel('target_language') || '';

      canvases.forEach(el => {
        // CSS transform: rotation
        let rotate = 0;
        if (rotation === '90')  rotate = 90;
        if (rotation === '180') rotate = 180;
        if (rotation === '270') rotate = 270;

        // Orientation: show landscape ratio
        let scaleX = 1, scaleY = 1;
        if (orient === 'landscape') {
          // squish portrait to landscape ratio visually
          scaleX = 1.3; scaleY = 0.75;
        }

        // CSS filter: quality/dpi simulation
        let filter = '';
        if (quality === 'screen') filter = 'contrast(0.75) saturate(0.6) blur(0.6px)';
        else if (quality === 'ebook') filter = 'contrast(0.88) saturate(0.85)';
        else if (quality === 'printer') filter = 'contrast(1.08) saturate(1.1)';
        else if (quality === 'prepress') filter = 'contrast(1.12) saturate(1.2) brightness(1.02)';
        // image quality %
        const qNum = parseInt(quality);
        if (!isNaN(qNum) && qNum <= 60)  filter = 'contrast(0.82) saturate(0.7) blur(0.4px)';
        else if (!isNaN(qNum) && qNum <= 75) filter = 'contrast(0.9) saturate(0.88)';
        else if (!isNaN(qNum) && qNum >= 100) filter = 'contrast(1.1) saturate(1.15) brightness(1.01)';

        if (dpi === '72')  filter = (filter||'') + ' blur(0.8px) contrast(0.8)';
        if (dpi === '300') filter = (filter||'') + ' contrast(1.1) saturate(1.1)';

        // OCR scan effect
        const isOcr = !!document.querySelector('[name$="[language]"],[name="language"]');
        if (isOcr) filter = (filter||'') + ' grayscale(0.3) contrast(1.15)';

        el.style.transition   = 'all 0.35s cubic-bezier(.4,0,.2,1)';
        el.style.transform    = `rotate(${rotate}deg) scale(${scaleX}, ${scaleY})`;
        el.style.filter       = filter || 'none';

        // Watermark overlay
        const parent  = el.closest('[class*="relative"]');
        const overlay = parent && parent.querySelector('.thumb-wm-overlay');
        if (overlay) {
          if (wmText.trim()) {
            overlay.classList.remove('hidden');
            const posStyles = {
              diagonal: 'items-center justify-center rotate-[-35deg]',
              center:   'items-center justify-center',
              header:   'items-start justify-center pt-2',
              footer:   'items-end justify-center pb-2'
            };
            overlay.className = 'thumb-wm-overlay absolute inset-0 flex pointer-events-none rounded-lg ' + (posStyles[wmPos] || posStyles.diagonal);
            overlay.innerHTML = `<span style="font-size:11px;font-weight:900;letter-spacing:2px;color:rgba(99,102,241,${wmOpacity*3});white-space:nowrap;text-shadow:0 0 2px rgba(0,0,0,0.1)">${wmText.toUpperCase()}</span>`;
          } else {
            overlay.classList.add('hidden');
          }
        }
      });

      // Update effects badge bar
      updateEffectsBadges(rotation, quality, dpi, orient, wmText, targetLang);
    }

    function updateEffectsBadges(rotation, quality, dpi, orient, wmText, targetLang) {
      const bar = document.getElementById('preview-effects-bar');
      if (!bar) return;
      const badges = [];
      if (rotation && rotation !== '0') badges.push({ icon: 'rotate_right', text: rotation + '°' });
      if (orient === 'landscape')       badges.push({ icon: 'screen_rotation', text: 'Landscape' });
      if (quality && isNaN(parseInt(quality))) badges.push({ icon: 'compress', text: quality });
      else if (!isNaN(parseInt(quality)) && quality) badges.push({ icon: 'high_quality', text: quality + '% quality' });
      if (dpi)     badges.push({ icon: 'image', text: dpi });
      if (wmText)  badges.push({ icon: 'branding_watermark', text: 'Watermark' });
      if (targetLang) badges.push({ icon: 'g_translate', text: '→ ' + targetLang });

      bar.innerHTML = badges.map(b =>
        `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-primary bg-primary/10 dark:bg-primary/20 px-2 py-1 rounded-full">
          <span class="material-symbols-outlined text-[11px]">${b.icon}</span>${b.text}
        </span>`
      ).join('');
    }

    // ── main file-input handler ───────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
      const fileInput    = document.getElementById('file_input');
      const uploadZone   = document.getElementById('upload-zone');
      const previewZone  = document.getElementById('file-preview-zone');
      const thumbsArea   = document.getElementById('preview-thumbnails');
      const fileInfo     = document.getElementById('preview-file-info');
      const changeBtn    = document.getElementById('change-file-btn');

      if (!fileInput) return;

      async function handleFiles(files) {
        if (!files.length) return;

        thumbsArea.innerHTML = `
          <div class="flex flex-col items-center gap-3 text-slate-400">
            <svg class="animate-spin size-8 text-primary" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"/>
              <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span class="text-sm font-medium text-primary">Generating preview…</span>
          </div>`;

        uploadZone.classList.add('hidden');
        previewZone.classList.remove('hidden');

        // Total size
        let totalBytes = 0;
        Array.from(files).forEach(f => totalBytes += f.size);
        fileInfo.textContent = files.length === 1
          ? `${files[0].name}  ·  ${fmtSize(totalBytes)}`
          : `${files.length} files  ·  ${fmtSize(totalBytes)} total`;

        thumbsArea.innerHTML = '';

        for (const file of Array.from(files)) {
          const ext = file.name.split('.').pop().toLowerCase();
          if (ext === 'pdf') {
            await renderPdf(file, thumbsArea);
          } else if (['jpg','jpeg','png','gif','webp','heic','bmp','tiff'].includes(ext)) {
            renderImage(file, thumbsArea);
          } else {
            // Generic file card for DOCX, XLSX, PPTX etc.
            const wrap = document.createElement('div');
            wrap.className = 'thumb-card flex flex-col items-center gap-2';
            const icon = { docx:'description', xlsx:'table_chart', pptx:'slideshow', zip:'folder_zip' }[ext] || 'insert_drive_file';
            wrap.innerHTML = `
              <div class="w-[${THUMB_W}px] h-[${Math.round(THUMB_W*1.3)}px] rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 flex flex-col items-center justify-center gap-2">
                <span class="material-symbols-outlined text-4xl text-primary/60">${icon}</span>
                <span class="text-xs font-bold text-slate-500 uppercase">${ext}</span>
              </div>
              <p class="text-xs text-center text-slate-500 max-w-[130px] truncate">${file.name}</p>`;
            thumbsArea.appendChild(wrap);
          }
        }
        applySettingsToThumbs();
      }

      fileInput.addEventListener('change', function(e) {
        if (e.target.files.length > 0) handleFiles(e.target.files);
      });

      // "Change file" button resets back to upload zone
      if (changeBtn) {
        changeBtn.addEventListener('click', function() {
          previewZone.classList.add('hidden');
          uploadZone.classList.remove('hidden');
          thumbsArea.innerHTML = '';
          fileInput.value = '';
        });
      }

      // Settings changes → re-apply effects on thumbnails
      const optionsBody = document.getElementById('options-body');
      if (optionsBody) {
        optionsBody.addEventListener('change', applySettingsToThumbs);
        optionsBody.addEventListener('input',  applySettingsToThumbs);
      }

      // Chevron already open on load
      const chevron = document.getElementById('options-chevron');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    });

    // ── options toggle ────────────────────────────────────
    window.toggleOptions = function() {
      const body    = document.getElementById('options-body');
      const chevron = document.getElementById('options-chevron');
      if (!body) return;
      const hidden = body.classList.toggle('hidden');
      chevron.style.transform = hidden ? 'rotate(0deg)' : 'rotate(180deg)';
    };

  })();
</script>
