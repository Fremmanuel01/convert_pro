<%# Renders a tool's options from ToolRegistry data — no per-tool markup branches.
   locals: options (array of option defs), f (form builder) %>
<% return if options.blank? %>
<% grouped = options.group_by { |o| o[:group] } %>

<div class="space-y-5">
  <% grouped.each do |group_name, opts| %>
    <div>
      <% if group_name.present? %>
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2.5"><%= group_name %></p>
      <% end %>
      <div class="grid <%= opts.any? { |o| o[:half] } ? 'grid-cols-2' : 'grid-cols-1' %> gap-3">
        <% opts.each do |opt| %>
          <div class="<%= 'col-span-2' unless opt[:half] %>">
            <label for="option_<%= opt[:key] %>" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5"><%= opt[:label] %></label>
            <% field_data = opt[:target] ? { client_tool_target: opt[:target] } : {} %>
            <% case opt[:type] %>
            <% when :select %>
              <%= f.select opt[:key], opt[:choices], { selected: opt[:default] }, class: "odt-input", id: "option_#{opt[:key]}" %>
            <% when :password %>
              <%= f.password_field opt[:key], required: opt[:required], placeholder: opt[:placeholder], value: opt[:default],
                    autocomplete: "new-password", class: "odt-input", id: "option_#{opt[:key]}", data: field_data %>
            <% when :number %>
              <%= f.number_field opt[:key], placeholder: opt[:placeholder], min: 1, class: "odt-input", id: "option_#{opt[:key]}" %>
            <% else %>
              <%= f.text_field opt[:key], value: opt[:default], placeholder: opt[:placeholder], class: "odt-input", id: "option_#{opt[:key]}", data: field_data %>
            <% end %>
            <% if opt[:hint].present? %>
              <p class="text-xs text-slate-400 mt-1.5"><%= opt[:hint] %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
