<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — OfficedocTools</title>
  <script>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark')
    }
  </script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap" rel="stylesheet"/>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload", "data-turbo-eval": "false" %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased min-h-screen flex">

  <!-- Sidebar -->
  <aside class="w-60 bg-[#0f1223] flex flex-col min-h-screen fixed left-0 top-0 z-40">
    <!-- Logo -->
    <div class="flex items-center gap-3 px-5 py-5 border-b border-white/10">
      <img src="/logo.png" alt="Logo" class="w-8 h-8 rounded-lg">
      <div>
        <div class="text-white font-bold text-sm leading-tight">OfficedocTools</div>
        <div class="text-white/40 text-[10px] font-medium uppercase tracking-widest">Admin</div>
      </div>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-4 space-y-1">
      <% [
        { path: admin_dashboard_path,  icon: "dashboard",    label: "Dashboard"   },
        { path: admin_users_path,      icon: "group",        label: "Users"       },
      ].each do |item| %>
        <%= link_to item[:path], class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all #{request.path.start_with?(item[:path]) ? 'bg-[#1f3dff] text-white' : 'text-white/60 hover:text-white hover:bg-white/10'}" do %>
          <span class="material-symbols-outlined text-[18px]"><%= item[:icon] %></span>
          <%= item[:label] %>
        <% end %>
      <% end %>
    </nav>

    <!-- Footer -->
    <div class="px-5 py-4 border-t border-white/10">
      <%= link_to root_path, class: "flex items-center gap-2 text-white/50 hover:text-white text-xs font-medium transition-colors" do %>
        <span class="material-symbols-outlined text-[14px]">arrow_back</span>
        Back to site
      <% end %>
    </div>
  </aside>

  <!-- Main -->
  <main class="flex-1 ml-60 min-h-screen">
    <!-- Top bar -->
    <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-30">
      <h1 class="text-lg font-bold text-slate-900"><%= content_for(:page_title) { "Dashboard" } %></h1>
      <div class="flex items-center gap-3">
        <span class="text-sm text-slate-500">Logged in as</span>
        <span class="text-sm font-semibold text-slate-900"><%= current_user.email %></span>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-xs text-slate-400 hover:text-red-500 transition-colors ml-2" do %>
          Sign out
        <% end %>
      </div>
    </header>

    <!-- Flash -->
    <% flash.each do |type, msg| %>
      <div class="mx-8 mt-4 px-4 py-3 rounded-xl text-sm font-medium <%= type == 'notice' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
        <%= msg %>
      </div>
    <% end %>

    <!-- Content -->
    <div class="p-8">
      <%= yield %>
    </div>
  </main>

</body>
</html>
