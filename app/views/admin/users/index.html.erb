<% content_for :page_title, "Users (#{@users.total_count})" %>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100">
    <h3 class="font-bold text-slate-900">All users</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100">
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Joined</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Plan</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Conversions</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Auth</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-[11px] font-bold flex-shrink-0"
                     style="background:linear-gradient(135deg,#1f3dff,#0ea5e9);">
                  <%= user.email[0].upcase %>
                </div>
                <span class="font-medium text-slate-900 truncate max-w-[200px]"><%= user.email %></span>
                <% if user.admin? %>
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-100 text-purple-700">Admin</span>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-3 text-slate-500"><%= user.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-3">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full <%= user.pro? ? 'bg-purple-100 text-purple-700' : 'bg-slate-100 text-slate-600' %>">
                <%= user.plan.capitalize %>
              </span>
            </td>
            <td class="px-6 py-3 font-semibold text-slate-700"><%= user.conversions_count %></td>
            <td class="px-6 py-3">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full <%= user.provider == 'google_oauth2' ? 'bg-blue-50 text-blue-600' : 'bg-slate-100 text-slate-600' %>">
                <%= user.provider == "google_oauth2" ? "Google" : "Email" %>
              </span>
            </td>
            <td class="px-6 py-3">
              <% if user.confirmed? %>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-green-50 text-green-600">Confirmed</span>
              <% else %>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-600">Pending</span>
              <% end %>
            </td>
            <td class="px-6 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <%= link_to "View", admin_user_path(user), class: "text-xs font-semibold text-[#1f3dff] hover:underline" %>
                <% unless user == current_user %>
                  <%= button_to "Delete", admin_user_path(user), method: :delete,
                      form: { data: { turbo_confirm: "Delete #{user.email}? This cannot be undone." } },
                      class: "text-xs font-semibold text-red-500 hover:text-red-700 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <!-- Pagination -->
  <% if @users.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between text-sm text-slate-500">
      <span>Page <%= @users.current_page %> of <%= @users.total_pages %></span>
      <div class="flex gap-2">
        <% if @users.prev_page %>
          <%= link_to "← Prev", admin_users_path(page: @users.prev_page), class: "px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-medium" %>
        <% end %>
        <% if @users.next_page %>
          <%= link_to "Next →", admin_users_path(page: @users.next_page), class: "px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-medium" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
