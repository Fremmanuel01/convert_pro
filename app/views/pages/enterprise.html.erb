<%- content_for :title, "For Teams & Business | OfficedocTools" %>
<%- content_for :meta_description, "Using OfficedocTools for work? Free document tools for your whole team, with Pro for unlimited conversions and larger files. Tell us what your team needs." %>

<div class="w-full max-w-2xl mx-auto px-6 py-16">
  <div class="text-center mb-10">
    <span class="odt-eyebrow mb-3">For teams &amp; business</span>
    <h1 class="text-3xl md:text-5xl font-serif font-medium tracking-tight text-slate-900 dark:text-white mb-4">
      Using OfficeDocTools for work?
    </h1>
    <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
      OfficeDocTools is a growing product. We don't yet offer team accounts, an API or formal support
      contracts — but if your team relies on document conversion and you'd like to talk about what you
      need, we'd genuinely like to hear from you.
    </p>
  </div>

  <div class="odt-card p-6 sm:p-8">
    <h2 class="font-bold text-slate-900 dark:text-white mb-3">What exists today</h2>
    <ul class="space-y-2.5 mb-6">
      <% ["All #{tool_count} document & image tools, free to try",
          "Pro removes limits: unlimited conversions, larger files, priority processing",
          "Files validated server-side, processed over an encrypted connection, and deleted after processing"].each do |item| %>
        <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300">
          <span class="material-symbols-outlined text-[18px] text-primary shrink-0">check_circle</span><%= item %>
        </li>
      <% end %>
    </ul>

    <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
      <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
        Tell us about your use case and we'll follow up personally.
      </p>
      <a href="mailto:hello@officedoctools.com?subject=OfficeDocTools%20for%20business"
         class="odt-btn odt-btn--primary">
        <span class="material-symbols-outlined text-[18px]">mail</span>
        Email hello@officedoctools.com
      </a>
    </div>
  </div>

  <p class="text-center text-sm text-slate-400 mt-6">
    <%= link_to "See pricing", pricing_path, class: "font-semibold text-primary hover:underline" %>
  </p>
</div>
