<%- content_for :title, "Solutions – OfficedocTools" %>

<!-- Hero -->
<div class="w-full max-w-5xl mx-auto px-6 pt-16 pb-12 text-center">
  <span class="inline-block px-4 py-1.5 mb-4 text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 rounded-full">Solutions</span>
  <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight text-slate-900 dark:text-white">The right tool for <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-indigo-400">every workflow</span></h1>
  <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">From individual freelancers to global teams, OfficedocTools adapts to how you work — converting, compressing and transforming office documents with precision.</p>
</div>

<!-- Use Case Cards -->
<div class="w-full max-w-5xl mx-auto px-6 pb-16">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">

    <!-- Freelancers -->
    <div class="glass-card p-8 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col gap-4">
      <div class="size-12 bg-blue-500/10 text-blue-500 rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-2xl">person</span>
      </div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Freelancers</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Convert client documents instantly. Deliver polished PDFs, compress large files and never get blocked by format incompatibilities again.</p>
      <ul class="space-y-2 mt-2">
        <% [["PDF to Word", "description"], ["Compress PDF", "compress"], ["Images to PDF", "imagesmode"]].each do |label, icon| %>
          <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
            <span class="material-symbols-outlined text-primary text-base">check_circle</span> <%= label %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Small Businesses -->
    <div class="glass-card p-8 rounded-2xl border border-primary/30 bg-primary/5 flex flex-col gap-4 relative overflow-hidden">
      <div class="absolute top-4 right-4 bg-primary text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full">Popular</div>
      <div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-2xl">business</span>
      </div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Small Businesses</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Standardise documents across your team. Convert Word, Excel and PowerPoint files to PDF for consistent sharing, branding and archiving.</p>
      <ul class="space-y-2 mt-2">
        <% [["Word to PDF", "description"], ["Excel/PPTX to PDF", "table_chart"], ["Merge & Split PDFs", "call_merge"]].each do |label, icon| %>
          <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
            <span class="material-symbols-outlined text-primary text-base">check_circle</span> <%= label %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Legal & Finance -->
    <div class="glass-card p-8 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col gap-4">
      <div class="size-12 bg-emerald-500/10 text-emerald-500 rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-2xl">gavel</span>
      </div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Legal & Finance</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Protect sensitive documents with password encryption, redact confidential content, and make scanned files fully searchable with OCR.</p>
      <ul class="space-y-2 mt-2">
        <% [["Protect & Encrypt PDF", "lock"], ["Redact PDF", "ink_eraser"], ["OCR PDF", "document_scanner"]].each do |label, icon| %>
          <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
            <span class="material-symbols-outlined text-primary text-base">check_circle</span> <%= label %>
          </li>
        <% end %>
      </ul>
    </div>

  </div>

  <!-- Feature Highlights -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
    <div class="flex items-start gap-5 p-6 glass-card rounded-2xl border border-slate-200 dark:border-slate-800">
      <div class="size-12 bg-violet-500/10 text-violet-500 rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-2xl">auto_awesome</span>
      </div>
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-1">AI-Powered Summarisation</h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Upload any long PDF and get a concise, structured executive summary in seconds — powered by cutting-edge AI.</p>
      </div>
    </div>
    <div class="flex items-start gap-5 p-6 glass-card rounded-2xl border border-slate-200 dark:border-slate-800">
      <div class="size-12 bg-amber-500/10 text-amber-500 rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-2xl">language</span>
      </div>
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-1">Webpage to PDF</h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Capture any public webpage as a perfectly formatted PDF — great for archiving articles, reports and web receipts.</p>
      </div>
    </div>
    <div class="flex items-start gap-5 p-6 glass-card rounded-2xl border border-slate-200 dark:border-slate-800">
      <div class="size-12 bg-rose-500/10 text-rose-500 rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-2xl">image</span>
      </div>
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-1">Image Format Conversion</h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Convert HEIC, WEBP, JPG and PNG images effortlessly. Perfect for sharing photos across all platforms and devices.</p>
      </div>
    </div>
    <div class="flex items-start gap-5 p-6 glass-card rounded-2xl border border-slate-200 dark:border-slate-800">
      <div class="size-12 bg-cyan-500/10 text-cyan-500 rounded-xl flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-2xl">cloud_done</span>
      </div>
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-1">Cloud Storage & History</h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Every conversion is saved securely in the cloud. Access and re-download your files anytime from your dashboard.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="text-center glass-card rounded-2xl border border-slate-200 dark:border-slate-800 p-12">
    <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-4">Ready to get started?</h2>
    <p class="text-slate-500 dark:text-slate-400 mb-8 max-w-xl mx-auto">Join thousands of users who trust OfficedocTools for their daily document needs.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Start for Free", new_user_registration_path, class: "bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl font-bold shadow-xl shadow-primary/30 transition-all text-decoration-none" %>
      <%= link_to "View Pricing", pricing_path, class: "bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white px-8 py-4 rounded-xl font-bold transition-all text-decoration-none" %>
    </div>
  </div>
</div>
