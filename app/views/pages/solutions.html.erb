<%- content_for :title, "What You Can Do — Document Tasks | OfficedocTools" %>
<%- content_for :meta_description, "Every common document job in one place: convert between formats, prepare and protect PDFs, OCR scans, and summarise or translate with AI. Free to try, no signup." %>

<div class="w-full max-w-5xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <span class="odt-eyebrow mb-3">What can you do</span>
    <h1 class="text-3xl md:text-5xl font-serif font-medium tracking-tight text-slate-900 dark:text-white mb-4">
      Get a document ready for work
    </h1>
    <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
      Pick the job you need done. Every one of these uses tools that exist today.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% [
      { icon: "sync_alt", title: "Convert documents", desc: "Move between Word, Excel, PowerPoint, PDF and images.",
        tools: [["Word to PDF", "docx_to_pdf"], ["PDF to Word", "pdf_to_docx"], ["Excel to PDF", "xlsx_to_pdf"]] },
      { icon: "picture_as_pdf", title: "Prepare PDFs", desc: "Merge, split, compress or rotate before you share.",
        tools: [["Merge PDF", "merge_pdf"], ["Split PDF", "split_pdf"], ["Compress PDF", "compress_pdf"]] },
      { icon: "document_scanner", title: "Work with scanned documents", desc: "Make scans searchable and pull out the text.",
        tools: [["OCR PDF", "ocr_pdf"], ["PDF to Text", "pdf_to_text"], ["PDF to Images", "pdf_to_images"]] },
      { icon: "lock", title: "Protect sensitive PDFs", desc: "Add a password, watermark, or strip hidden layers.",
        tools: [["Protect PDF", "protect_pdf"], ["Watermark PDF", "watermark_pdf"], ["Redact PDF", "redact_pdf"]] },
      { icon: "upload_file", title: "Prepare files for submission", desc: "Combine photos into a PDF or shrink a file to fit a limit.",
        tools: [["Images to PDF", "images_to_pdf"], ["Compress PDF", "compress_pdf"], ["HEIC to JPG", "heic_to_jpg"]] },
      { icon: "auto_awesome", title: "Extract information", desc: "Summarise or translate a long document with AI.",
        tools: [["Summarize PDF", "summarize_pdf"], ["Translate PDF", "ai_translate_pdf"], ["PDF to Text", "pdf_to_text"]] }
    ].each do |job| %>
      <div class="odt-card p-6">
        <div class="flex items-center gap-3 mb-2">
          <span class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]"><%= job[:icon] %></span>
          </span>
          <h2 class="font-bold text-slate-900 dark:text-white"><%= job[:title] %></h2>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4"><%= job[:desc] %></p>
        <div class="flex flex-wrap gap-2">
          <% job[:tools].each do |label, id| %>
            <%= link_to label, tool_path(id), class: "inline-flex items-center gap-1 text-xs font-semibold text-primary bg-primary/10 hover:bg-primary/15 px-2.5 py-1.5 rounded-lg transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-10">
    <%= link_to "Browse all #{tool_count} tools", tools_path, class: "odt-btn odt-btn--secondary" %>
  </div>
</div>
