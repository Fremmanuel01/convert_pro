<% content_for :title, "Pricing — Free & Pro | OfficedocTools" %>
<% content_for :meta_description, "OfficedocTools is free to use. Upgrade to Pro for unlimited conversions, larger files, OCR and AI document tools. Simple monthly or yearly pricing, no card to start." %>
<% pricing_faq = [
     ["Is OfficedocTools really free?",
      "Yes. You can use the tools without an account, and creating a free account gives you #{ConversionLimiter::FREE_LIMIT} conversions. Pro removes the limit when document work becomes a regular part of your day."],
     ["What do I get with Pro?",
      "Unlimited conversions, larger file uploads, OCR and AI tools, priority processing, and your conversion history."],
     ["Can I cancel anytime?",
      "Yes. Pro is a simple monthly or yearly subscription, and you can cancel whenever you like — you keep Pro until the end of the period you paid for."],
     ["How do payments work?",
      "Payments are handled securely through Paystack. No card is needed for the free plan, and the yearly plan includes two months free."],
     ["Are my documents safe?",
      "Files are sent over an encrypted connection and deleted automatically after processing. Several image and PDF tools run entirely in your browser and never leave your device."]
   ] %>
<% content_for :jsonld do %>
  <%= json_ld({
    "@context" => "https://schema.org", "@type" => "Product",
    "name" => "OfficedocTools", "url" => canonical_url(pricing_path),
    "description" => "Free online document tools, with an optional Pro plan for unlimited conversions, larger files, OCR and AI tools.",
    "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD",
                  "description" => "Free plan — #{ConversionLimiter::FREE_LIMIT} conversions to start" }
  }) %>
  <%= json_ld(faq_schema(pricing_faq)) %>
<% end %>

<div class="max-w-4xl mx-auto w-full px-6 py-14">
  <div class="text-center mb-10">
    <span class="odt-eyebrow mb-3">Pricing</span>
    <h1 class="text-3xl md:text-5xl font-serif font-medium tracking-tight text-slate-900 dark:text-white mb-3">
      Start free. Upgrade when you need more.
    </h1>
    <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
      Every tool is free to try. Pro removes limits when document work becomes part of your day.
    </p>
  </div>

  <!-- Billing cycle toggle -->
  <div class="flex items-center justify-center mb-10" data-controller="billing-toggle">
    <div class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
      <button type="button" data-billing-toggle-target="tab" data-cycle="monthly" data-action="billing-toggle#select"
              class="tool-tab is-active px-5 py-2 rounded-lg text-sm font-semibold">Monthly</button>
      <button type="button" data-billing-toggle-target="tab" data-cycle="yearly" data-action="billing-toggle#select"
              class="tool-tab px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2">
        Yearly
        <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400">2 months free</span>
      </button>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    <!-- Free -->
    <div class="odt-card p-8 flex flex-col">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Free</h2>
      <div class="mt-2 flex items-baseline gap-1">
        <span class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white"><%= BillingPlans::CURRENCY_SYMBOL %>0</span>
        <span class="text-slate-500">/month</span>
      </div>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Great for the occasional document task.</p>
      <ul class="mt-6 space-y-3 flex-1">
        <% BillingPlans.free_features.each do |f| %>
          <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-[20px] text-slate-400"><%= f[:icon] %></span>
            <%= f[:text] %>
          </li>
        <% end %>
      </ul>
      <% unless user_signed_in? %>
        <%= link_to "Get started free", new_user_registration_path, class: "odt-btn odt-btn--secondary odt-btn--block mt-8" %>
      <% else %>
        <div class="odt-btn odt-btn--secondary odt-btn--block mt-8 cursor-default">You're on Free</div>
      <% end %>
    </div>

    <%# Pro is visually emphasized as a genuine recommendation — no fake urgency badge. %>
    <div class="odt-card p-8 flex flex-col border-primary/40 ring-1 ring-primary/20">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Pro</h2>
        <span class="odt-badge">Best for regular work</span>
      </div>
      <div class="mt-2 flex items-baseline gap-1">
        <span class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white"
              data-billing-toggle-target="price"
              data-monthly="<%= BillingPlans.display_price('monthly') %>"
              data-yearly="<%= BillingPlans.display_price('yearly') %>"><%= BillingPlans.display_price('monthly') %></span>
        <span class="text-slate-500" data-billing-toggle-target="period">/month</span>
      </div>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Everything in Free, without the limits.</p>
      <ul class="mt-6 space-y-3 flex-1">
        <% BillingPlans.pro_features.each do |f| %>
          <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-[20px] text-primary"><%= f[:icon] %></span>
            <%= f[:text] %>
          </li>
        <% end %>
      </ul>

      <% if user_signed_in? && current_user.pro? && current_user.active? %>
        <div class="odt-btn odt-btn--secondary odt-btn--block mt-8 cursor-default">Your current plan</div>
      <% else %>
        <%= link_to (user_signed_in? ? "Upgrade to Pro" : "Create account & upgrade"),
              (user_signed_in? ? upgrade_billing_path(plan: 'monthly') : new_user_registration_path),
              data: { billing_toggle_target: "cta", monthly_url: upgrade_billing_path(plan: 'monthly'), yearly_url: upgrade_billing_path(plan: 'yearly') },
              class: "odt-btn odt-btn--primary odt-btn--block mt-8" %>
      <% end %>
    </div>
  </div>

  <!-- Reassurance row -->
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
    <% [["credit_card_off", "No card for Free", "Start without entering payment details."],
        ["cancel", "Cancel anytime", "No lock-in — stop whenever you like."],
        ["verified_user", "Secure payments", "Billed securely through Paystack."]].each do |icon, title, body| %>
      <div class="flex flex-col items-center gap-1">
        <span class="material-symbols-outlined text-[22px] text-primary"><%= icon %></span>
        <span class="text-sm font-semibold text-slate-900 dark:text-white"><%= title %></span>
        <span class="text-xs text-slate-500 dark:text-slate-400 max-w-[14rem]"><%= body %></span>
      </div>
    <% end %>
  </div>

  <!-- FAQ -->
  <section class="mt-16 max-w-2xl mx-auto">
    <h2 class="text-2xl font-serif font-medium tracking-tight text-slate-900 dark:text-white text-center mb-6">
      Pricing questions
    </h2>
    <div class="space-y-2">
      <% pricing_faq.each do |q, a| %>
        <details class="odt-card p-4 group">
          <summary class="flex items-center justify-between cursor-pointer list-none text-sm font-medium text-slate-900 dark:text-white">
            <%= q %>
            <span class="material-symbols-outlined text-[20px] text-slate-400 transition-transform group-open:rotate-180">expand_more</span>
          </summary>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mt-2.5"><%= a %></p>
        </details>
      <% end %>
    </div>
  </section>
</div>
