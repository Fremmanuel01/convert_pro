<% content_for :title, "OfficedocTools — Free Online PDF & Document Tools" %>
<% content_for :meta_description, "Convert PDF to Word, merge PDFs, compress files, OCR scans, convert HEIC to JPG and more. #{tool_count} free document tools — fast, private, no signup needed." %>
<% content_for :jsonld do %>
  <%= json_ld({
    "@context" => "https://schema.org", "@type" => "WebApplication",
    "name" => "OfficedocTools", "url" => canonical_host,
    "applicationCategory" => "BusinessApplication", "operatingSystem" => "Web",
    "description" => "#{tool_count} free online tools to convert, compress, merge, protect and OCR PDF, Word, Excel, PowerPoint and image files.",
    "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" }
  }) %>
  <%= json_ld({
    "@context" => "https://schema.org", "@type" => "Organization",
    "name" => "OfficedocTools", "url" => canonical_host, "logo" => "#{canonical_host}/logo.png"
  }) %>
<% end %>

<style>
  @keyframes slideUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
  @keyframes scaleIn { from { opacity:0; transform:scale(.94); } to { opacity:1; transform:scale(1); } }
  .d1 { animation: slideUp .6s cubic-bezier(.22,1,.36,1) .04s both; }
  .d2 { animation: slideUp .6s cubic-bezier(.22,1,.36,1) .12s both; }
  .d3 { animation: slideUp .6s cubic-bezier(.22,1,.36,1) .20s both; }
  .d4 { animation: slideUp .6s cubic-bezier(.22,1,.36,1) .28s both; }
  .d5 { animation: scaleIn .6s cubic-bezier(.22,1,.36,1) .30s both; }
  .reveal { opacity:0; transform:translateY(24px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in { opacity:1; transform:translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .d1,.d2,.d3,.d4,.d5 { animation: none; }
    .reveal { opacity:1; transform:none; transition:none; }
  }
</style>

<!-- ══════════════════ HERO ══════════════════ -->
<section id="top" class="relative w-full overflow-hidden" style="scroll-margin-top:5rem;">
  <!-- faint single-tone wash -->
  <div class="absolute inset-x-0 top-0 h-[26rem] -z-10 bg-gradient-to-b from-primary/[0.05] via-primary/[0.015] to-transparent"></div>

  <div class="max-w-6xl mx-auto w-full px-6 lg:px-12 py-16 lg:py-24 grid lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-14 items-center">

    <!-- Copy -->
    <div class="flex flex-col gap-6">
      <span class="d1 odt-eyebrow"><%= tool_count %> document tools, one workspace</span>

      <h1 class="d2 font-serif font-medium text-[2.75rem] lg:text-6xl leading-[1.04] tracking-tight text-slate-900 dark:text-white">
        Everything you need to get a document <span class="text-primary italic">ready for work.</span>
      </h1>

      <p class="d3 text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg">
        Convert, compress, merge, protect and OCR — across PDF, Word, Excel, PowerPoint and images.
        Drop a file and we'll show you exactly what you can do with it.
      </p>

      <div class="d4 flex flex-col sm:flex-row gap-3 pt-1">
        <a href="#top-uploader" class="odt-btn odt-btn--primary odt-btn--lg">
          <span class="material-symbols-outlined text-[20px]">upload_file</span>
          Convert a file — free
        </a>
        <a href="#tools" class="odt-btn odt-btn--secondary odt-btn--lg">
          Browse all <%= tool_count %> tools
        </a>
      </div>

      <ul class="d4 flex flex-wrap gap-x-6 gap-y-2 pt-3 text-sm text-slate-500 dark:text-slate-400">
        <li class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px] text-slate-400">check_circle</span> No signup to start</li>
        <li class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px] text-slate-400">lock</span> Files deleted after processing</li>
        <li class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px] text-slate-400">bolt</span> Done in seconds</li>
      </ul>
    </div>

    <!-- Live product window: the uploader framed as the real app -->
    <div class="d5">
      <div class="odt-card shadow-lg overflow-hidden">
        <!-- window chrome -->
        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
          <span class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-rose-400"></span>
            <span class="size-2.5 rounded-full bg-amber-400"></span>
            <span class="size-2.5 rounded-full bg-emerald-400"></span>
          </span>
          <span class="mx-auto inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md px-3 py-1">
            <span class="material-symbols-outlined text-[14px] text-slate-400">lock</span>officedoctools.com
          </span>
        </div>
        <!-- window body = live uploader -->
        <div class="p-5 sm:p-6" id="top-uploader">
          <p class="text-sm font-semibold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">upload_file</span>
            What do you need to do with your file?
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Add a file to see the tools that work with it. No account needed to start.</p>
          <%= render "shared/uploader", mode: "recommend", tools: @tool_index %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════ POPULAR TASKS ══════════════════ -->
<section class="py-16 lg:py-20 px-6 lg:px-16 xl:px-20 max-w-7xl mx-auto w-full">
  <div class="flex items-end justify-between mb-8 reveal">
    <div>
      <span class="odt-eyebrow mb-2">Popular tasks</span>
      <h2 class="text-2xl lg:text-3xl font-serif font-medium tracking-tight text-slate-900 dark:text-white">Start with a common job</h2>
    </div>
    <a href="/tools" class="hidden sm:inline-flex odt-btn odt-btn--ghost">All <%= tool_count %> tools →</a>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    <% [
      { id:"compress_pdf", icon:"compress",      name:"Compress PDF",  desc:"Shrink file size" },
      { id:"pdf_to_docx",  icon:"description",   name:"PDF to Word",   desc:"Editable document" },
      { id:"merge_pdf",    icon:"call_merge",    name:"Merge PDF",     desc:"Combine into one" },
      { id:"docx_to_pdf",  icon:"picture_as_pdf",name:"Word to PDF",   desc:"Share-ready PDF" },
      { id:"images_to_pdf",icon:"photo_library", name:"Images to PDF", desc:"Photos into a PDF" },
      { id:"ocr_pdf",      icon:"document_scanner",name:"OCR PDF",     desc:"Make it searchable" },
      { id:"heic_to_jpg",  icon:"photo_camera",  name:"HEIC to JPG",   desc:"iPhone photos" },
      { id:"split_pdf",    icon:"content_cut",   name:"Split PDF",     desc:"Extract pages" },
    ].each do |t| %>
      <a href="/tools/<%= t[:id] %>?from=home" class="odt-card p-4 flex items-center gap-3 hover:border-primary/40 transition-colors no-underline group">
        <span class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[22px]"><%= t[:icon] %></span>
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-bold text-slate-900 dark:text-white truncate"><%= t[:name] %></span>
          <span class="block text-xs text-slate-400 truncate"><%= t[:desc] %></span>
        </span>
      </a>
    <% end %>
  </div>
  <a href="/tools" class="sm:hidden mt-5 odt-btn odt-btn--secondary odt-btn--block">See all <%= tool_count %> tools</a>
</section>

<!-- ══════════════════ VALUE ══════════════════ -->
<section class="py-16 lg:py-20 px-6 lg:px-16 xl:px-20 bg-white dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800">
  <div class="max-w-5xl mx-auto text-center reveal">
    <span class="odt-eyebrow mb-3">One workspace</span>
    <h2 class="text-2xl lg:text-4xl font-serif font-medium tracking-tight text-slate-900 dark:text-white mb-4">
      One place for every document task
    </h2>
    <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-12">
      Stop hunting for a different website for each job. Convert, compress, merge, protect and OCR —
      then move straight to the next step without re-uploading.
    </p>
    <div class="grid sm:grid-cols-3 gap-6 text-left">
      <% [
        { icon:"apps",         t:"Every format in one tab", d:"PDF, Word, Excel, PowerPoint and images — no switching sites." },
        { icon:"account_tree", t:"Connected steps",         d:"Finish a conversion and we suggest the sensible next action." },
        { icon:"lock",         t:"Handled with care",       d:"Encrypted transfer, server-side checks, files deleted after processing." },
      ].each do |v| %>
        <div class="reveal">
          <span class="size-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[24px]"><%= v[:icon] %></span>
          </span>
          <h3 class="font-bold text-slate-900 dark:text-white mb-1.5"><%= v[:t] %></h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed"><%= v[:d] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ══════════════════ HOW IT WORKS ══════════════════ -->
<section class="py-16 lg:py-20 px-6 lg:px-16 xl:px-20 max-w-5xl mx-auto w-full">
  <div class="text-center mb-12 reveal">
    <span class="odt-eyebrow mb-2">How it works</span>
    <h2 class="text-2xl lg:text-3xl font-serif font-medium tracking-tight text-slate-900 dark:text-white">Three steps, a few seconds</h2>
  </div>
  <div class="grid md:grid-cols-3 gap-5">
    <% [
      { n:"1", icon:"upload_file", t:"Add your file", d:"Drop it in or pick from your device. We check the type before anything runs." },
      { n:"2", icon:"tune",        t:"Choose options", d:"Set output format, quality or page range where it applies. Sensible defaults otherwise." },
      { n:"3", icon:"download",    t:"Download",       d:"Your result is ready in seconds, then deleted after processing." },
    ].each do |s| %>
      <div class="odt-card p-6 reveal">
        <div class="flex items-center gap-3 mb-3">
          <span class="size-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center"><%= s[:n] %></span>
          <span class="material-symbols-outlined text-primary"><%= s[:icon] %></span>
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white mb-1.5"><%= s[:t] %></h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed"><%= s[:d] %></p>
      </div>
    <% end %>
  </div>
</section>

<!-- ══════════════════ FREE VS PRO (outcome-based) ══════════════════ -->
<section id="pricing-preview" class="py-16 lg:py-20 px-6 lg:px-16 xl:px-20 max-w-4xl mx-auto w-full">
  <div class="text-center mb-10 reveal">
    <span class="odt-eyebrow mb-2">Free &amp; Pro</span>
    <h2 class="text-2xl lg:text-3xl font-serif font-medium tracking-tight text-slate-900 dark:text-white">Free to try. Pro when it's part of your day.</h2>
  </div>
  <div class="grid md:grid-cols-2 gap-5 reveal">
    <div class="odt-card p-6">
      <h3 class="font-bold text-slate-900 dark:text-white mb-3">Free</h3>
      <ul class="space-y-2.5">
        <% BillingPlans.free_features.each do |f| %>
          <li class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
            <span class="material-symbols-outlined text-[18px] text-slate-400"><%= f[:icon] %></span><%= f[:text] %>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="odt-card p-6 border-primary/40 ring-1 ring-primary/20">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-slate-900 dark:text-white">Pro</h3>
        <span class="text-sm font-semibold text-slate-500"><%= BillingPlans.display_price('monthly') %>/mo</span>
      </div>
      <ul class="space-y-2.5">
        <% BillingPlans.pro_features.each do |f| %>
          <li class="flex items-center gap-2.5 text-sm text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-[18px] text-primary"><%= f[:icon] %></span><%= f[:text] %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
  <div class="text-center mt-6">
    <a href="<%= pricing_path %>" class="odt-btn odt-btn--ghost">Compare plans →</a>
  </div>
</section>

<!-- ══════════════════ TRUST ══════════════════ -->
<section class="py-16 px-6 lg:px-16 xl:px-20 bg-white dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800">
  <div class="max-w-4xl mx-auto grid sm:grid-cols-3 gap-6 text-center reveal">
    <% [
      { icon:"lock",         t:"Encrypted transfer",  d:"Files move over an encrypted connection." },
      { icon:"auto_delete",  t:"Deleted after use",   d:"Uploads and results are removed after processing." },
      { icon:"shield_lock",  t:"Some tools stay local", d:"Several image and PDF tools run entirely in your browser." },
    ].each do |c| %>
      <div>
        <span class="material-symbols-outlined text-primary text-[26px] mb-2"><%= c[:icon] %></span>
        <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-1"><%= c[:t] %></h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed"><%= c[:d] %></p>
      </div>
    <% end %>
  </div>
  <p class="text-center text-xs text-slate-400 mt-6 max-w-xl mx-auto">
    AI tools (summarize, translate, generate) send document text to a third-party AI provider — each of those tools tells you before you submit.
  </p>
</section>

<!-- ══════════════════ FINAL CTA ══════════════════ -->
<section class="py-20 px-6 text-center">
  <div class="max-w-2xl mx-auto reveal">
    <h2 class="text-2xl lg:text-3xl font-serif font-medium tracking-tight text-slate-900 dark:text-white mb-3">
      Ready when you are
    </h2>
    <p class="text-slate-500 dark:text-slate-400 mb-7">Add a file at the top of the page, or browse every tool.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="#top" class="odt-btn odt-btn--primary odt-btn--lg">
        <span class="material-symbols-outlined text-[20px]">upload_file</span> Add a file
      </a>
      <a href="/tools" class="odt-btn odt-btn--secondary odt-btn--lg">Browse all tools</a>
    </div>
  </div>
</section>

<script>
  const ro = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }),
    { threshold: 0.07, rootMargin: '0px 0px -50px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
</script>
