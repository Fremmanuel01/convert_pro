<% content_for :head do %>
  <title>OfficedocTools — Free Online PDF & Document Converter | 28 Professional Tools</title>
  <meta name="description" content="Convert PDF to Word, merge PDFs, compress files, convert HEIC to JPG and more. 28 free professional document tools. Fast, secure — works in your browser, no software needed.">
  <meta name="keywords" content="PDF converter, PDF to Word, merge PDF, compress PDF, PDF tools, document converter, free PDF editor online, HEIC to JPG, Word to PDF, Excel to PDF, PowerPoint to PDF">
  <meta property="og:title" content="OfficedocTools — Free Online PDF & Document Converter">
  <meta property="og:description" content="28 professional document conversion tools. Convert PDF, Word, Excel, PowerPoint, and images instantly in your browser.">
  <meta property="og:type" content="website">
  <link rel="canonical" href="https://officedoctools.com">
<% end %>

<style>
  @keyframes floatA {
    0%,100% { transform: translateY(0px) rotate(-1.5deg); }
    50%      { transform: translateY(-18px) rotate(1.5deg); }
  }
  @keyframes floatB {
    0%,100% { transform: translateY(0px) rotate(1deg); }
    50%      { transform: translateY(-14px) rotate(-1deg); }
  }
  @keyframes floatC {
    0%,100% { transform: translateY(0px); }
    50%      { transform: translateY(-20px); }
  }
  @keyframes floatD {
    0%,100% { transform: translateY(0px) rotate(2deg); }
    50%      { transform: translateY(-10px) rotate(-2deg); }
  }
  @keyframes slideUp {
    from { opacity:0; transform:translateY(48px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes scaleIn {
    from { opacity:0; transform:scale(0.88); }
    to   { opacity:1; transform:scale(1); }
  }
  @keyframes shimmerText {
    from { background-position: -200% center; }
    to   { background-position:  200% center; }
  }
  @keyframes marqueeScroll {
    from { transform:translateX(0); }
    to   { transform:translateX(-50%); }
  }
  @keyframes scanLine {
    0%   { top:-4px; opacity:.8; }
    100% { top:110%; opacity:0; }
  }
  @keyframes ringExpand {
    0%   { transform:scale(1);   opacity:.45; }
    100% { transform:scale(2);   opacity:0; }
  }
  @keyframes orbitSpin {
    from { transform:rotate(0deg); }
    to   { transform:rotate(360deg); }
  }

  .fa { animation: floatA 7s ease-in-out infinite; }
  .fb { animation: floatB 9s ease-in-out infinite; }
  .fc { animation: floatC 11s ease-in-out infinite; }
  .fd { animation: floatD 8s ease-in-out infinite 2.5s; }

  .d1 { animation: slideUp .75s cubic-bezier(.22,1,.36,1) .05s both; }
  .d2 { animation: slideUp .75s cubic-bezier(.22,1,.36,1) .18s both; }
  .d3 { animation: slideUp .75s cubic-bezier(.22,1,.36,1) .32s both; }
  .d4 { animation: slideUp .75s cubic-bezier(.22,1,.36,1) .46s both; }
  .d5 { animation: scaleIn .8s  cubic-bezier(.22,1,.36,1) .62s both; }

  .shimmer-text {
    background: linear-gradient(90deg,
      #1f3dff 0%, #0ea5e9 20%, #10b981 40%, #f59e0b 60%, #ef6c00 80%, #1f3dff 100%);
    background-size: 250% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmerText 5s linear infinite;
  }

  .marquee-wrap { animation: marqueeScroll 32s linear infinite; }
  .marquee-wrap:hover { animation-play-state: paused; }

  .scan-fx {
    position:absolute; left:0; right:0; height:3px;
    background: linear-gradient(90deg, transparent 0%, #1f3dff 35%, #0ea5e9 65%, transparent 100%);
    animation: scanLine 3.5s ease-in-out infinite;
    border-radius: 999px;
  }

  .ring-a { animation: ringExpand 2.8s ease-out infinite; }
  .ring-b { animation: ringExpand 2.8s ease-out .9s infinite; }

  .card-lift {
    transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease;
  }
  .card-lift:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 28px 55px -14px rgba(31,61,255,.2);
  }

  .reveal {
    opacity:0; transform:translateY(36px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.in { opacity:1; transform:translateY(0); }

  .orbit-ring {
    background: conic-gradient(from 0deg, #1f3dff, #0ea5e9, #10b981, #f59e0b, #ef6c00, #1f3dff);
    border-radius: 9999px;
    animation: orbitSpin 12s linear infinite;
  }
</style>

<!-- ══════════════════ HERO ══════════════════ -->
<section class="relative w-full min-h-[calc(100vh-4.5rem)] flex items-center overflow-hidden">
