          {id:"webp_to_jpg", ic:"broken_image", bg:"rgba(14,165,233,.09)",  cl:"#0ea5e9", t:"WebP to JPG", d:"Convert WebP images to JPEG"},
          {id:"webp_to_png", ic:"broken_image", bg:"rgba(20,184,166,.09)",  cl:"#14b8a6", t:"WebP to PNG", d:"Convert WebP to PNG format"},
        ]},
      { label:"Generate Documents", lc:"#8b5cf6", tools:[
          {id:"ai_generate_pptx", ic:"slideshow",     bg:"rgba(239,108,0,.09)",  cl:"#EF6C00", t:"Generate Presentation", d:"Create a PowerPoint from a prompt"},
          {id:"ai_generate_docx", ic:"edit_document", bg:"rgba(30,136,229,.09)", cl:"#1E88E5", t:"Generate Document",     d:"Create a Word document from a prompt"},
        ]},
    ].each do |cat| %>
      <div class="mb-12 reveal">
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-5 flex items-center gap-3">
          <span class="w-7 h-0.5 rounded-full" style="background:<%= cat[:lc] %>;"></span>
          <%= cat[:label] %>
        </h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
          <% cat[:tools].each do |tool| %>
            <a href="/tools/<%= tool[:id] %>"
               class="card-lift group flex items-center gap-3.5 p-4 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200/60 dark:border-slate-800/60 hover:border-primary/40 dark:hover:border-primary/30 no-underline">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
                   style="background:<%= tool[:bg] %>;">
                <span class="material-symbols-outlined text-[20px]" style="color:<%= tool[:cl] %>;"><%= tool[:ic] %></span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors truncate"><%= tool[:t] %></div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-snug"><%= tool[:d] %></div>
              </div>
              <span class="material-symbols-outlined text-slate-300 dark:text-slate-600 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0 text-lg">chevron_right</span>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

