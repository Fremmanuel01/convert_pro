<% user_greeting = case Time.current.hour; when 0..11 then 'Good morning'; when 12..17 then 'Good afternoon'; else 'Good evening'; end %>

<div class="max-w-6xl mx-auto w-full mt-8 px-4 sm:px-6">
  
  <!-- Header with Dynamic Greeting -->
  <div class="mb-10 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        <%= user_greeting %>, <%= current_user.email.split('@').first.capitalize %>!
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-lg font-medium">Welcome back to your unified conversion workspace.</p>
    </div>
    
    <% unless current_user.pro? %>
      <div>
        <%= link_to upgrade_billing_path, class: "group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary to-indigo-600 hover:from-primary/90 hover:to-indigo-600/90 text-white font-bold py-3 px-6 rounded-2xl shadow-lg shadow-primary/20 transition-all hover:scale-105 active:scale-95 overflow-hidden" do %>
          <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
          <span class="material-symbols-outlined text-xl relative z-10">stars</span>
          <span class="relative z-10">Upgrade to Pro</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- System Alert (Limits) -->
  <% unless @limiter.can_convert? %>
    <div class="mb-8 rounded-2xl p-5 flex items-start sm:items-center gap-4 border bg-rose-50/80 dark:bg-rose-900/20 border-rose-200 dark:border-rose-800 shadow-rose-500/5 text-rose-800 dark:text-rose-200 shadow-lg animate-fade-in-up">
      <div class="shrink-0 mt-0.5 sm:mt-0">
        <span class="material-symbols-outlined text-2xl text-rose-600 dark:text-rose-400">error</span>
      </div>
      <div class="flex-1 text-sm font-bold">
        <%= @limiter.status_message %>
      </div>
      <div>
        <%= link_to "Manage Billing", upgrade_billing_path, class: "text-xs font-black uppercase tracking-wider bg-white/50 hover:bg-white dark:bg-rose-950/50 dark:hover:bg-rose-900 px-4 py-2 rounded-lg transition-colors border border-rose-200 dark:border-rose-800" %>
      </div>
    </div>
  <% end %>

  <!-- Glassmorphic Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    
    <!-- Current Plan -->
    <div class="relative overflow-hidden group bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-slate-200/50 dark:border-slate-800/50 p-6 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      <div class="relative z-10 flex items-start gap-4">
        <div class="size-14 rounded-2xl <%= current_user.pro? ? 'bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-lg shadow-orange-500/20' : 'bg-gradient-to-br from-slate-200 to-slate-300 dark:from-slate-700 dark:to-slate-800 text-slate-700 dark:text-slate-300' %> flex items-center justify-center shrink-0 transition-transform group-hover:scale-110 duration-500">
          <span class="material-symbols-outlined text-3xl"><%= current_user.pro? ? 'workspace_premium' : 'account_circle' %></span>
        </div>
        <div>
          <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1">Current Plan</h3>
          <p class="text-3xl font-black text-slate-900 dark:text-white capitalize tracking-tight flex items-baseline gap-2">
            <%= current_user.plan.capitalize %>
            <% if current_user.pro? %>
              <span class="inline-flex size-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <!-- Conversions Used -->
    <div class="relative overflow-hidden group bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-slate-200/50 dark:border-slate-800/50 p-6 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      <div class="relative z-10 flex items-start gap-4">
        <div class="size-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white shadow-lg shadow-indigo-500/20 flex items-center justify-center shrink-0 transition-transform group-hover:rotate-12 duration-500">
          <span class="material-symbols-outlined text-3xl">data_usage</span>
        </div>
        <div>
          <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1">Total Conversions</h3>
          <p class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            <%= current_user.conversions_count %>
            <% unless current_user.pro? %>
              <span class="text-sm font-medium text-slate-400">/ 5 Free</span>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <!-- Account Status -->
    <div class="relative overflow-hidden group bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-slate-200/50 dark:border-slate-800/50 p-6 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      <div class="relative z-10 flex items-start gap-4">
        <div class="size-14 rounded-2xl <%= current_user.active? ? 'bg-gradient-to-br from-emerald-400 to-teal-500 text-white shadow-lg shadow-emerald-500/20' : 'bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-lg shadow-amber-500/20' %> flex items-center justify-center shrink-0 transition-transform group-hover:scale-110 duration-500">
          <span class="material-symbols-outlined text-3xl"><%= current_user.active? ? 'verified_user' : 'gpp_maybe' %></span>
        </div>
        <div>
          <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1">Billing Status</h3>
          <div class="mt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= current_user.active? ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30' : (current_user.free? ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/20 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-500/30' : 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300 border border-amber-200 dark:border-amber-500/30') %> shadow-sm backdrop-blur-md">
              <span class="size-1.5 rounded-full <%= current_user.active? ? 'bg-emerald-500' : (current_user.free? ? 'bg-indigo-500' : 'bg-amber-500') %>"></span>
              <%= current_user.pro? ? current_user.subscription_status.upcase : 'FREE LIFETIME' %>
            </span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left Column: Conversions History -->
    <div class="lg:col-span-2">
      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/20">
          <h3 class="text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">history</span>
            Recent Conversions
          </h3>
          <% if @recent_conversions.any? %>
            <%= link_to "View All", conversions_path, class: "text-sm font-bold text-primary hover:text-indigo-600 transition-colors" %>
          <% end %>
        </div>

        <div class="p-0">
          <% if @recent_conversions.any? %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                    <th class="px-6 py-4">Tool</th>
                    <th class="px-6 py-4">Date</th>
                    <th class="px-6 py-4 text-center">Status</th>
                    <th class="px-6 py-4 text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                  <% @recent_conversions.each do |conversion| %>
                    <% tool_info = ToolRegistry.tools.find { |t| t[:class_name] == conversion.tool_name } || { title: conversion.tool_name, icon: 'build' } %>
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/20 transition-colors group">
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                          <div class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 group-hover:bg-primary/10 group-hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-lg"><%= tool_info[:icon] %></span>
                          </div>
                          <div>
                            <p class="text-sm font-bold text-slate-900 dark:text-white"><%= tool_info[:title] %></p>
                            <p class="text-xs text-slate-500"><%= conversion.processing_time&.round(2) || '0.0' %>s execution</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= time_ago_in_words(conversion.created_at) %> ago</p>
                        <p class="text-xs text-slate-500"><%= conversion.created_at.strftime("%b %d, %Y") %></p>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <% if conversion.error_message.present? %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-400">Failed</span>
                        <% elsif conversion.output_file.attached? %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400">Ready</span>
                        <% else %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-400">Processing</span>
                        <% end %>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <%= link_to conversion_path(conversion), class: "inline-flex items-center justify-center size-9 rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors" do %>
                          <span class="material-symbols-outlined text-xl">arrow_forward</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="py-16 text-center">
              <div class="size-20 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4 border-2 border-dashed border-slate-300 dark:border-slate-700">
                <span class="material-symbols-outlined text-4xl text-slate-400">receipt_long</span>
              </div>
              <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2">No Conversions Yet</h4>
              <p class="text-sm text-slate-500 mb-6 max-w-xs mx-auto">You haven't processed any files yet. Head over to the tools section to get started!</p>
              <%= link_to tools_path, class: "inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-2 px-6 rounded-xl shadow-md transition-transform hover:-translate-y-0.5" do %>
                <span class="material-symbols-outlined text-sm">rocket_launch</span>
                Start Converting
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column: Premium CTA Banner -->
    <div class="lg:col-span-1">
      <div class="relative h-full overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950 to-primary p-8 shadow-2xl text-white flex flex-col justify-between group">
        
        <!-- Animated Background Orbs -->
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 size-64 bg-white/10 rounded-full blur-3xl pointer-events-none group-hover:scale-150 transition-transform duration-1000"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 size-48 bg-indigo-500/30 rounded-full blur-2xl pointer-events-none group-hover:scale-110 transition-transform duration-1000 delay-100"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase mb-6 border border-white/20">
            <span class="material-symbols-outlined text-sm text-amber-400">bolt</span>
            Quick Action
          </div>
          
          <h3 class="text-3xl font-black mb-4 leading-tight">
            Ready to <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 to-amber-400">transform</span><br/> your files?
          </h3>
          
          <% if @limiter.can_convert? %>
            <p class="text-indigo-100 font-medium text-sm leading-relaxed mb-8">Access our full suite of ultra-high-fidelity PDF conversion tools seamlessly.</p>
          <% else %>
            <p class="text-rose-200 font-medium text-sm leading-relaxed mb-8">You've reached your free limit! Upgrade your plan to continue turning documents into masterpieces.</p>
          <% end %>
        </div>
        
        <div class="relative z-10 w-full">
          <% if @limiter.can_convert? %>
            <%= link_to tools_path, class: "w-full flex items-center justify-between bg-white text-slate-900 group-hover:bg-slate-50 font-bold py-4 px-6 rounded-2xl shadow-xl transition-all hover:scale-[1.02] active:scale-95" do %>
              <span class="flex items-center gap-3">
                <span class="material-symbols-outlined text-indigo-600">apps</span>
                Launch Workspace
              </span>
              <span class="material-symbols-outlined text-slate-400">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to billing_path, class: "w-full flex items-center justify-between bg-white text-slate-900 group-hover:bg-slate-50 font-bold py-4 px-6 rounded-2xl shadow-xl transition-all hover:scale-[1.02] active:scale-95" do %>
              <span class="flex items-center gap-3">
                <span class="material-symbols-outlined text-amber-500">credit_card</span>
                Manage Billing
              </span>
              <span class="material-symbols-outlined text-slate-400">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>
