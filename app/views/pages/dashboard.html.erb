<% greeting = case Time.current.hour; when 0..11 then 'Good morning'; when 12..17 then 'Good afternoon'; else 'Good evening'; end
   pro = current_user.pro? && current_user.active?
   premium_left = current_user.premium_credits_used.to_i < ConversionLimiter::FREE_PREMIUM_CREDITS %>

<div class="max-w-6xl mx-auto w-full mt-6 px-4 sm:px-6">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      <%= greeting %>, <%= current_user.email.split('@').first.capitalize %>
    </h1>
    <p class="text-slate-500 dark:text-slate-400 mt-1">Pick up where you left off, or start something new.</p>
  </div>

  <!-- Quick access to tools -->
  <section class="mb-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Quick access</h2>
      <%= link_to "All tools", tools_path, class: "text-sm font-semibold text-primary hover:underline" %>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <% @quick_tools.each do |tool| %>
        <%= link_to tool_path(tool[:id]),
              class: "odt-card p-4 flex flex-col items-center text-center gap-2 hover:border-primary/40 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" do %>
          <span class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[22px]"><%= tool[:icon] %></span>
          </span>
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 leading-tight"><%= tool[:name] %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="grid lg:grid-cols-3 gap-6">
    <!-- Recent activity -->
    <div class="lg:col-span-2">
      <div class="odt-card overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
          <h2 class="font-bold text-slate-900 dark:text-white">Recent conversions</h2>
          <% if @recent_conversions.any? %>
            <%= link_to "View all", conversions_path, class: "text-sm font-semibold text-primary hover:underline" %>
          <% end %>
        </div>

        <% if @recent_conversions.any? %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-800">
            <% @recent_conversions.each do |conversion| %>
              <% tool = ToolRegistry.tools.find { |t| t[:class_name] == conversion.tool_name } || { name: "Conversion", icon: "description" } %>
              <li>
                <%= link_to conversion_path(conversion), class: "flex items-center gap-3 px-5 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors" do %>
                  <span class="size-9 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-300 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]"><%= tool[:icon] %></span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold text-slate-900 dark:text-white truncate"><%= tool[:name] %></span>
                    <span class="block text-xs text-slate-400"><%= time_ago_in_words(conversion.created_at) %> ago</span>
                  </span>
                  <% if conversion.failed? %>
                    <span class="text-xs font-semibold text-rose-600 dark:text-rose-400">Failed</span>
                  <% elsif conversion.output_file.attached? %>
                    <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Ready</span>
                  <% else %>
                    <span class="text-xs font-semibold text-amber-600 dark:text-amber-400">Processing</span>
                  <% end %>
                  <span class="material-symbols-outlined text-[18px] text-slate-300 dark:text-slate-600">chevron_right</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="py-14 text-center">
            <span class="material-symbols-outlined text-4xl text-slate-300 dark:text-slate-600 mb-2">folder_open</span>
            <p class="font-semibold text-slate-900 dark:text-white mb-1">No conversions yet</p>
            <p class="text-sm text-slate-500 mb-5">Your processed files will show up here.</p>
            <%= link_to "Browse tools", tools_path, class: "odt-btn odt-btn--primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Usage + plan -->
    <div class="space-y-6">
      <div class="odt-card p-5">
        <h2 class="font-bold text-slate-900 dark:text-white mb-3">Your plan</h2>
        <div class="flex items-center justify-between mb-4">
          <span class="odt-badge"><%= pro ? "Pro" : "Free" %></span>
          <% if pro %>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1">
              <span class="size-1.5 rounded-full bg-emerald-500"></span><%= current_user.subscription_status.capitalize %>
            </span>
          <% end %>
        </div>

        <% if pro %>
          <p class="text-sm text-slate-500 dark:text-slate-400">Unlimited conversions and priority processing are active.</p>
          <%= link_to "Manage billing", billing_path, class: "odt-btn odt-btn--secondary odt-btn--block mt-4" %>
        <% else %>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
            Basic tools are free and unlimited.
            <%= premium_left ? "You still have a free AI & OCR conversion to try." : "You've used your free AI & OCR try." %>
          </p>
          <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-[18px] text-primary">auto_awesome</span>
            <span class="text-slate-600 dark:text-slate-300">AI &amp; OCR: <%= premium_left ? "1 free try available" : "Pro required" %></span>
          </div>
        <% end %>
      </div>

      <% unless pro %>
        <%= render "shared/upgrade_prompt", reason: "ai", cycle: "monthly", compact: true %>
      <% end %>
    </div>
  </div>
</div>
