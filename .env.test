# Test environment configuration — NON-SECRET dummy values only.
# Committed to source control on purpose so the test suite never depends on a
# developer's local .env or on real external credentials.
#
# dotenv-rails loads .env.test BEFORE .env in the test environment and does not
# overwrite keys already set, so every value here wins over .env during tests.

# Active Storage uses the :test Disk service in test (see config/environments/test.rb),
# so Cloudinary is never actually contacted. This valid dummy URL only exists to
# stop the cloudinary gem from raising URI::InvalidURIError while parsing the real
# (placeholder) CLOUDINARY_URL from .env at boot.
CLOUDINARY_URL=cloudinary://000000000000000:aaaaaaaaaaaaaaaaaaaaaaaaaaa@test-cloud

# Payments — stubbed in specs via WebMock; these just satisfy presence checks.
PAYSTACK_PUBLIC_KEY=pk_test_dummy
PAYSTACK_SECRET_KEY=sk_test_dummy
PAYSTACK_MONTHLY_PLAN_CODE=PLN_test_monthly
PAYSTACK_YEARLY_PLAN_CODE=PLN_test_yearly

# AI providers — never called for real in tests (HTTP is stubbed / disabled).
ANTHROPIC_API_KEY=sk-ant-test-dummy
GROQ_API_KEY=gsk_test_dummy

# Firebase — token verification is stubbed in specs.
FIREBASE_PROJECT_ID=officedoctools-test
